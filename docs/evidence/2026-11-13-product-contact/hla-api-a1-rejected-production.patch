diff --git a/packages/pipelines/reporting_attention_records.py b/packages/pipelines/reporting_attention_records.py
new file mode 100644
index 0000000..1bd3119
--- /dev/null
+++ b/packages/pipelines/reporting_attention_records.py
@@ -0,0 +1,128 @@
+"""Attention item -> authorized source record reads.
+
+An attention item's ``item_id`` is the canonical identity of the source rows
+behind it (see ``refresh_open_attention_items``). A record read binds the whole
+item id against the source relation, so that relation proves — or disproves —
+the key, and no lookup can select another row. Reads never cross access modes:
+a PUBLISHED read is answered by the publication store only. ``None`` means the
+key is provably absent; ``AttentionRecordUnavailable`` means the source could
+not answer (missing relation, or rows with a NULL identity).
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from typing import Any, NamedTuple
+
+from packages.domains.finance.pipelines.subscription_models import (
+    MART_UPCOMING_FIXED_COSTS_30D_TABLE,
+)
+from packages.domains.finance.pipelines.transaction_models import (
+    MART_TRANSACTION_ANOMALIES_CURRENT_TABLE,
+)
+from packages.domains.utilities.pipelines.utility_models import (
+    MART_CONTRACT_RENEWAL_WATCHLIST_TABLE,
+    MART_CONTRACT_REVIEW_CANDIDATES_TABLE,
+)
+from packages.pipelines.reporting_snapshots import run_on_warehouse
+from packages.storage.postgres_reporting import PostgresReportingStore
+
+_PLACEHOLDER = "?"
+
+
+class AttentionRecordUnavailable(Exception):
+    """The authorized source cannot prove or disprove the requested item."""
+
+
+class AttentionRecordSource(NamedTuple):
+    """The source relation that authorizes one attention item type."""
+
+    segment: str
+    relation_name: str
+    key_expression: str  # SQL rebuilding the attention publication's item_id
+
+
+# item type -> the route segment and source relation that authorize it. Each
+# key expression rebuilds the item id exactly as the attention publication does.
+ATTENTION_RECORD_SOURCES: dict[str, AttentionRecordSource] = {
+    "anomaly": AttentionRecordSource(
+        "transaction-anomalies", MART_TRANSACTION_ANOMALIES_CURRENT_TABLE,
+        "'anomaly_' || transaction_id",
+    ),
+    "contract_review": AttentionRecordSource(
+        "contract-review-candidates", MART_CONTRACT_REVIEW_CANDIDATES_TABLE,
+        "'review_' || contract_id || '_' || reason",
+    ),
+    "contract_renewal": AttentionRecordSource(
+        "contract-renewal-watchlist", MART_CONTRACT_RENEWAL_WATCHLIST_TABLE,
+        "'renewal_' || contract_id || '_' || CAST(renewal_date AS VARCHAR)",
+    ),
+    "upcoming_cost": AttentionRecordSource(
+        "upcoming-fixed-costs", MART_UPCOMING_FIXED_COSTS_30D_TABLE,
+        "'upcoming_' || charge_id || '_' || CAST(expected_date AS VARCHAR)",
+    ),
+}
+
+
+def lookup_source_record(
+    source: AttentionRecordSource,
+    item_id: str,
+    fetch: Callable[[str, list[Any]], list[dict[str, Any]]],
+) -> list[dict[str, Any]] | None:
+    """Rows authorized by ``item_id``, or ``None`` when it is provably absent.
+
+    The key predicate is complete before a row is read; the scalar probe runs
+    only after it matched nothing, because a relation holding NULL identities
+    cannot vouch for the absence of any key.
+    """
+    rows = fetch(
+        f"SELECT * FROM {source.relation_name} "
+        f"WHERE {source.key_expression} = {_PLACEHOLDER}",
+        [item_id],
+    )
+    if rows:
+        return rows
+    missing = fetch(
+        "SELECT COUNT(*) AS missing_identity_rows "
+        f"FROM {source.relation_name} WHERE ({source.key_expression}) IS NULL",
+        [],
+    )
+    if missing and int(missing[0]["missing_identity_rows"]):
+        raise AttentionRecordUnavailable(
+            f"{source.relation_name} holds rows with an unknown identity"
+        )
+    return None
+
+
+def read_published_attention_record(
+    store: PostgresReportingStore,
+    source: AttentionRecordSource,
+    item_id: str,
+) -> list[dict[str, Any]] | None:
+    """Look the item up in the publication store only."""
+    return lookup_source_record(
+        source,
+        item_id,
+        lambda sql, params: store.fetchall_dicts(sql.replace(_PLACEHOLDER, "%s"), params),
+    )
+
+
+def read_warehouse_attention_record(
+    transformation_service: Any,
+    source: AttentionRecordSource,
+    item_id: str,
+) -> list[dict[str, Any]] | None:
+    """Look the item up in the warehouse on one leased read-only handle."""
+
+    def read(store: Any) -> list[dict[str, Any]] | None:
+        exists = store.fetchall(
+            "SELECT COUNT(*) FROM information_schema.tables WHERE table_name = ?",
+            [source.relation_name],
+        )
+        if not exists or not exists[0][0]:
+            raise AttentionRecordUnavailable(f"{source.relation_name} is not available")
+        return lookup_source_record(source, item_id, store.fetchall_dicts)
+
+    return run_on_warehouse(
+        transformation_service, f"attention_record.{source.segment}", read, write=False
+    )
