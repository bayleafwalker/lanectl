+    def get_attention_record(self, item_type: str, item_id: str) -> list[dict[str, Any]]:
+        """Resolve one opaque attention id to the source rows it names.
+
+        The whole id is bound, at the source, against the relation's own key
+        expression, so ids carrying separators or slashes are never split and
+        a partial or equal-looking id selects nothing. ``PUBLISHED`` reads only
+        the source publication; a missing one, or one whose identity columns
+        can be NULL, cannot prove absence and raises unavailable.
+        """
+        record = ATTENTION_SOURCE_RECORDS_BY_TYPE.get(item_type)
+        if record is None:
+            raise AttentionRecordNotFoundError(item_type)
+        fetch, placeholder = self._attention_record_source(record.relation_name)
+        sql, params = attention_record_query(record, item_id, placeholder=placeholder)
+        rows = fetch(sql, params)
+        if rows:
+            return rows
+        probe = attention_identity_probe_query(record)
+        if probe is not None:
+            probe_sql, probe_params = probe
+            unkeyed = fetch(probe_sql, probe_params)
+            if unkeyed and int(unkeyed[0]["unkeyed_rows"]) > 0:
+                raise AttentionRecordUnavailableError(record.relation_name)
+        raise AttentionRecordNotFoundError(item_type)
+
+    def _attention_record_source(
+        self,
+        relation_name: str,
+    ) -> tuple[Callable[[str, list[Any]], list[dict[str, Any]]], str]:
+        """Reader and parameter marker that own source rows for ``relation_name``."""
+
+        def read_warehouse(sql: str, params: list[Any]) -> list[dict[str, Any]]:
+            return run_on_warehouse(
+                self._transformation_service,
+                f"attention_record.{relation_name}",
+                lambda store: store.fetchall_dicts(sql, params),
+                write=False,
+            )
+
+        if self._access_mode != ReportingAccessMode.WAREHOUSE:
+            if self._publication_store is not None and self._publication_store.table_exists(
+                relation_name
+            ):
+                return self._publication_store.fetchall_dicts, "%s"
+            if self._access_mode == ReportingAccessMode.PUBLISHED:
+                raise AttentionRecordUnavailableError(relation_name)
+        return read_warehouse, "?"
+
