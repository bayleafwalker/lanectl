diff --git a/packages/pipelines/reporting_attention_records.py b/packages/pipelines/reporting_attention_records.py
new file mode 100644
index 0000000..be5474b
--- /dev/null
+++ b/packages/pipelines/reporting_attention_records.py
@@ -0,0 +1,103 @@
+"""Attention item ids and the source publications that own them.
+
+An attention id is opaque: the overview layer builds it from a source row's
+own identity columns (``review_<contract_id>_<reason>``, and so on), so it can
+contain slashes and underscores and can cover several source rows. Resolution
+binds the whole id against that same expression at the source relation.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from packages.domains.finance.pipelines.subscription_models import (
+    MART_UPCOMING_FIXED_COSTS_30D_TABLE,
+)
+from packages.domains.finance.pipelines.transaction_models import (
+    MART_TRANSACTION_ANOMALIES_CURRENT_TABLE,
+)
+from packages.domains.utilities.pipelines.utility_models import (
+    MART_CONTRACT_RENEWAL_WATCHLIST_TABLE,
+    MART_CONTRACT_REVIEW_CANDIDATES_TABLE,
+)
+
+
+@dataclass(frozen=True)
+class AttentionSourceRecord:
+    """One item type: source relation, key expression, nullable identities.
+
+    A NULL in ``nullable_identity_columns`` makes the key unprovable: while
+    such a row exists, a missing id cannot be reported as absent.
+    """
+
+    item_type: str
+    relation_name: str
+    key_expression: str
+    nullable_identity_columns: tuple[str, ...] = ()
+    order_by: str = ""
+
+
+ATTENTION_SOURCE_RECORDS: tuple[AttentionSourceRecord, ...] = (
+    AttentionSourceRecord(
+        "anomaly",
+        MART_TRANSACTION_ANOMALIES_CURRENT_TABLE,
+        "'anomaly_' || transaction_id",
+        order_by="booking_date DESC, transaction_id",
+    ),
+    AttentionSourceRecord(
+        "contract_review",
+        MART_CONTRACT_REVIEW_CANDIDATES_TABLE,
+        "'review_' || contract_id || '_' || reason",
+        order_by="score DESC, contract_id",
+    ),
+    AttentionSourceRecord(
+        "contract_renewal",
+        MART_CONTRACT_RENEWAL_WATCHLIST_TABLE,
+        "'renewal_' || contract_id || '_' || CAST(renewal_date AS VARCHAR)",
+        order_by="renewal_date, contract_id",
+    ),
+    AttentionSourceRecord(
+        "upcoming_cost",
+        MART_UPCOMING_FIXED_COSTS_30D_TABLE,
+        "'upcoming_' || charge_id || '_' || CAST(expected_date AS VARCHAR)",
+        nullable_identity_columns=("charge_id",),
+        order_by="expected_date, contract_name",
+    ),
+)
+
+ATTENTION_SOURCE_RECORDS_BY_TYPE: dict[str, AttentionSourceRecord] = {
+    record.item_type: record for record in ATTENTION_SOURCE_RECORDS
+}
+
+
+class AttentionRecordNotFoundError(LookupError):
+    """The id is provably absent from the source publication."""
+
+
+class AttentionRecordUnavailableError(RuntimeError):
+    """The source cannot prove absence: unpublished, or unkeyed rows exist."""
+
+
+def attention_record_query(
+    record: AttentionSourceRecord, item_id: str, *, placeholder: str
+) -> tuple[str, list[str]]:
+    """Select the source rows whose own key rebuilds to ``item_id``."""
+    return (
+        f"SELECT * FROM {record.relation_name}"
+        f" WHERE {record.key_expression} = {placeholder}"
+        f" ORDER BY {record.order_by}"
+    ), [item_id]
+
+
+def attention_identity_probe_query(
+    record: AttentionSourceRecord,
+) -> tuple[str, list[str]] | None:
+    """Count rows whose identity is NULL, when the key can be null."""
+    if not record.nullable_identity_columns:
+        return None
+    missing_identity = " OR ".join(
+        f"{column} IS NULL" for column in record.nullable_identity_columns
+    )
+    return (
+        f"SELECT COUNT(*) AS unkeyed_rows FROM {record.relation_name}"
+        f" WHERE {missing_identity}"
+    ), []
