index 0000000..bbf1371
--- /dev/null
+++ b/packages/domains/overview/pipelines/attention_records.py
@@ -0,0 +1,170 @@
+"""Attention item ids, their source publications, and their identity keys."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Callable
+
+import duckdb
+import psycopg
+
+from packages.domains.finance.pipelines.subscription_models import (
+    MART_UPCOMING_FIXED_COSTS_30D_TABLE,
+)
+from packages.domains.finance.pipelines.transaction_models import (
+    MART_TRANSACTION_ANOMALIES_CURRENT_TABLE,
+)
+from packages.domains.overview.pipelines.overview_models import MART_OPEN_ATTENTION_ITEMS_TABLE
+from packages.domains.utilities.pipelines.utility_models import (
+    MART_CONTRACT_RENEWAL_WATCHLIST_TABLE,
+    MART_CONTRACT_REVIEW_CANDIDATES_TABLE,
+)
+from packages.pipelines.reporting_snapshots import run_on_warehouse
+
+
+@dataclass(frozen=True)
+class AttentionSourceRecord:
+    """One item type: relation, exact key expression, and identity components."""
+
+    item_type: str
+    relation_name: str
+    key_expression: str
+    identity_columns: tuple[str, ...]
+    text_identity_columns: tuple[str, ...]
+    order_by: str
+
+
+ATTENTION_SOURCE_RECORDS: tuple[AttentionSourceRecord, ...] = (
+    AttentionSourceRecord(
+        "anomaly",
+        MART_TRANSACTION_ANOMALIES_CURRENT_TABLE,
+        "'anomaly_' || transaction_id",
+        ("transaction_id",),
+        ("transaction_id",),
+        "booking_date DESC, transaction_id",
+    ),
+    AttentionSourceRecord(
+        "contract_review",
+        MART_CONTRACT_REVIEW_CANDIDATES_TABLE,
+        "'review_' || contract_id || '_' || reason",
+        ("contract_id", "reason"),
+        ("contract_id", "reason"),
+        "score DESC, contract_id",
+    ),
+    AttentionSourceRecord(
+        "contract_renewal",
+        MART_CONTRACT_RENEWAL_WATCHLIST_TABLE,
+        "'renewal_' || contract_id || '_' || CAST(renewal_date AS VARCHAR)",
+        ("contract_id", "renewal_date"),
+        ("contract_id",),
+        "renewal_date, contract_id",
+    ),
+    AttentionSourceRecord(
+        "upcoming_cost",
+        MART_UPCOMING_FIXED_COSTS_30D_TABLE,
+        "'upcoming_' || charge_id || '_' || CAST(expected_date AS VARCHAR)",
+        ("charge_id", "expected_date"),
+        ("charge_id",),
+        "expected_date, contract_name",
+    ),
+)
+
+ATTENTION_SOURCE_RECORDS_BY_TYPE: dict[str, AttentionSourceRecord] = {
+    record.item_type: record for record in ATTENTION_SOURCE_RECORDS
+}
+
+
+class AttentionRecordNotFoundError(LookupError):
+    """The id is provably absent from the source publication."""
+
+
+class AttentionRecordUnavailableError(RuntimeError):
+    """The source cannot prove absence: unpublished, unkeyed, or unreadable."""
+
+
+def attention_record_query(
+    record: AttentionSourceRecord, item_id: str, *, placeholder: str
+) -> tuple[str, list[str]]:
+    """Select the source rows whose own key rebuilds to ``item_id``."""
+    guards = " AND ".join(
+        [f"{column} IS NOT NULL" for column in record.identity_columns]
+        + [f"{column} <> ''" for column in record.text_identity_columns]
+    )
+    return (
+        f"SELECT * FROM {record.relation_name}"
+        f" WHERE {record.key_expression} = {placeholder} AND {guards}"
+        f" ORDER BY {record.order_by}"
+    ), [item_id]
+
+
+def attention_identity_probe_query(record: AttentionSourceRecord) -> tuple[str, list[str]]:
+    """Count rows whose identity component is missing or empty."""
+    missing = " OR ".join(
+        [f"{column} IS NULL" for column in record.identity_columns]
+        + [f"{column} = ''" for column in record.text_identity_columns]
+    )
+    return (
+        f"SELECT COUNT(*) AS unkeyed_rows FROM {record.relation_name} WHERE {missing}"
+    ), []
+
+
+class AttentionReportingMixin:
+    """Overview-owned attention reads on the reporting facade."""
+
+    def get_open_attention_items(self: Any) -> list[dict[str, Any]]:
+        return self._fetch_published_or_fallback(
+            MART_OPEN_ATTENTION_ITEMS_TABLE,
+            lambda: self._read_mart(MART_OPEN_ATTENTION_ITEMS_TABLE),
+            ("", []),
+            "ORDER BY severity, item_type",
+        )
+
+    def get_attention_record(self: Any, item_type: str, item_id: str) -> list[dict[str, Any]]:
+        record = ATTENTION_SOURCE_RECORDS_BY_TYPE.get(item_type)
+        if record is None:
+            raise AttentionRecordNotFoundError(item_type)
+        fetch, placeholder = self._attention_record_source(record.relation_name)
+        sql, params = attention_record_query(record, item_id, placeholder=placeholder)
+        rows = self._attention_source_read(fetch, sql, params, record.relation_name)
+        if rows:
+            return rows
+        probe_sql, probe_params = attention_identity_probe_query(record)
+        unkeyed = self._attention_source_read(fetch, probe_sql, probe_params, record.relation_name)
+        if unkeyed and int(unkeyed[0]["unkeyed_rows"]) > 0:
+            raise AttentionRecordUnavailableError(record.relation_name)
+        raise AttentionRecordNotFoundError(item_type)
+
+    def _attention_source_read(
+        self: Any,
+        fetch: Callable[[str, list[Any]], list[dict[str, Any]]],
+        sql: str,
+        params: list[Any],
+        relation_name: str,
+    ) -> list[dict[str, Any]]:
+        try:
+            return fetch(sql, params)
+        except (duckdb.Error, psycopg.Error) as exc:
+            raise AttentionRecordUnavailableError(relation_name) from exc
+
+    def _attention_record_source(
+        self: Any, relation_name: str
+    ) -> tuple[Callable[[str, list[Any]], list[dict[str, Any]]], str]:
+        def read_warehouse(sql: str, params: list[Any]) -> list[dict[str, Any]]:
+            return run_on_warehouse(
+                self._transformation_service,
+                f"attention_record.{relation_name}",
+                lambda store: store.fetchall_dicts(sql, params),
+                write=False,
+            )
+
+        if self._access_mode == "warehouse":
+            return read_warehouse, "?"
+        try:
+            if self._publication_store is not None and self._publication_store.table_exists(
+                relation_name
+            ):
+                return self._publication_store.fetchall_dicts, "%s"
+        except (duckdb.Error, psycopg.Error) as exc:
+            raise AttentionRecordUnavailableError(relation_name) from exc
+        if self._access_mode == "published":
+            raise AttentionRecordUnavailableError(relation_name)
+        return read_warehouse, "?"
