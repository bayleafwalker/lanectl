+++ b/tests/test_attention_record_failures.py
@@ -0,0 +1,72 @@
+from __future__ import annotations
+
+from pathlib import Path
+from unittest.mock import patch
+
+import psycopg
+import pytest
+from fastapi.testclient import TestClient
+
+from packages.pipelines.reporting_service import ReportingAccessMode, ReportingService
+from packages.pipelines.transformation_service import TransformationService
+from packages.storage.duckdb_store import DuckDBStore, WarehouseBusyError
+from packages.storage.postgres_reporting import PostgresReportingStore
+from tests.postgres_test_support import running_postgres_container
+from tests.test_attention_record_api import (
+    DuckPublicationStore,
+    make_client,
+    publish,
+    record_path,
+    refresh,
+    seed,
+    source_key,
+)
+
+
+def _seeded() -> tuple[TransformationService, str]:
+    ts = TransformationService(DuckDBStore.memory())
+    seed(ts)
+    refresh(ts)
+    row = ts.store.fetchall_dicts("SELECT * FROM mart_upcoming_fixed_costs_30d")[0]
+    return ts, record_path("upcoming_cost", source_key("upcoming_cost", row))
+
+
+@pytest.mark.integration
+@pytest.mark.slow
+def test_published_connection_failure_is_safe_and_does_not_fall_back(tmp_path: Path) -> None:
+    ts, path = _seeded()
+    with running_postgres_container() as dsn:
+        store = PostgresReportingStore(dsn)
+        publish(ts, store)
+        reporting = ReportingService(ts, publication_store=store, access_mode=ReportingAccessMode.PUBLISHED)
+        client = make_client(tmp_path, ts, reporting)
+        assert client.get(path).status_code == 200
+        with patch.object(store, "_connect", side_effect=psycopg.OperationalError("synthetic marker")):
+            response = client.get(path)
+        assert response.status_code == 503
+        assert set(response.json()) == {"detail"}
+        assert "synthetic marker" not in response.text
+        assert client.get(path).status_code == 200
+
+
+def test_warehouse_busy_keeps_canonical_retry_response(tmp_path: Path) -> None:
+    ts, path = _seeded()
+    reporting = ReportingService(ts, access_mode=ReportingAccessMode.WAREHOUSE)
+    client = make_client(tmp_path, ts, reporting)
+    busy = WarehouseBusyError("synthetic", 1, RuntimeError("held"))
+    with patch("packages.domains.overview.pipelines.attention_records.run_on_warehouse", side_effect=busy):
+        response = client.get(path)
+    assert response.status_code == 503
+    assert response.headers["Retry-After"] == "5"
+    assert response.json()["retry_after_seconds"] == 5
+
+
+def test_programming_error_is_not_reported_as_unavailable(tmp_path: Path) -> None:
+    ts, path = _seeded()
+    store = DuckPublicationStore()
+    publish(ts, store)
+    reporting = ReportingService(ts, publication_store=store, access_mode=ReportingAccessMode.PUBLISHED)
+    app = make_client(tmp_path, ts, reporting).app
+    client = TestClient(app, raise_server_exceptions=False)
+    with patch.object(store, "table_exists", side_effect=RuntimeError("synthetic bug")):
+        assert client.get(path).status_code == 500
