diff --git a/apps/api/routes/attention_record_routes.py b/apps/api/routes/attention_record_routes.py
new file mode 100644
index 0000000..8a03fd3
--- /dev/null
+++ b/apps/api/routes/attention_record_routes.py
@@ -0,0 +1,55 @@
+"""Source-authorized attention record endpoints."""
+from typing import Any, Callable
+
+from fastapi import FastAPI, HTTPException
+
+from apps.api.response_models import build_rows_response_model
+from apps.api.routes.report_routes import (
+    CONTRACT_RENEWAL_WATCHLIST_ROW_MODEL,
+    CONTRACT_REVIEW_CANDIDATES_ROW_MODEL,
+    TRANSACTION_ANOMALIES_ROW_MODEL,
+    UPCOMING_FIXED_COSTS_ROW_MODEL,
+)
+from packages.domains.overview.pipelines.attention_records import (
+    AttentionRecordNotFoundError,
+    AttentionRecordUnavailableError,
+)
+from packages.pipelines.reporting_service import ReportingService
+
+
+def register_attention_record_routes(
+    app: FastAPI, reporting: ReportingService | None, to_jsonable: Callable[[Any], Any]
+) -> None:
+    for item_type, segment, row_model in (
+        ("anomaly", "transaction-anomalies", TRANSACTION_ANOMALIES_ROW_MODEL),
+        ("contract_review", "contract-review-candidates", CONTRACT_REVIEW_CANDIDATES_ROW_MODEL),
+        ("contract_renewal", "contract-renewal-watchlist", CONTRACT_RENEWAL_WATCHLIST_ROW_MODEL),
+        ("upcoming_cost", "upcoming-fixed-costs", UPCOMING_FIXED_COSTS_ROW_MODEL),
+    ):
+        def register(kind: str, route: str, model: Any) -> None:
+            async def get_attention_record(item_id: str) -> dict[str, Any]:
+                if reporting is None:
+                    raise HTTPException(status_code=404, detail="Requires a transformation service.")
+                try:
+                    rows = reporting.get_attention_record(kind, item_id)
+                except AttentionRecordUnavailableError:
+                    raise HTTPException(
+                        status_code=503,
+                        detail="The source publication cannot prove this attention item is absent.",
+                    ) from None
+                except AttentionRecordNotFoundError:
+                    raise HTTPException(
+                        status_code=404, detail="No source record has this attention item id."
+                    ) from None
+                return {"item_id": item_id, "rows": to_jsonable(rows)}
+
+            response = build_rows_response_model(
+                ''.join(part.title() for part in route.split('-')) + 'RecordResponse',
+                model, {"item_id": (str, ...)},
+            )
+            app.get(
+                f"/reports/{route}/records/{{item_id:path}}",
+                response_model=response,
+                name=f"get_{kind}_record",
+            )(get_attention_record)
+        register(item_type, segment, row_model)
