 )
+# One attention item id -> the source rows it names; ``rows`` is the same
+# public row model that source publication serves.
+ATTENTION_RECORD_ROW_MODELS: dict[str, Any] = {
+    "transaction-anomalies": TRANSACTION_ANOMALIES_ROW_MODEL,
+    "upcoming-fixed-costs": UPCOMING_FIXED_COSTS_ROW_MODEL,
+    "contract-review-candidates": CONTRACT_REVIEW_CANDIDATES_ROW_MODEL,
+    "contract-renewal-watchlist": CONTRACT_RENEWAL_WATCHLIST_ROW_MODEL,
+}
+ATTENTION_RECORD_RESPONSE_MODELS: dict[str, Any] = {
+    segment: build_rows_response_model(
+        f"{_pascal_case(segment)}RecordResponse", row_model, {"item_id": (str, ...)}
+    )
+    for segment, row_model in ATTENTION_RECORD_ROW_MODELS.items()
+}
 BUDGET_VARIANCE_RESPONSE_MODEL = build_rows_response_model(
     "BudgetVarianceResponse",
     BUDGET_VARIANCE_ROW_MODEL,
@@ -909,6 +927,45 @@ def register_report_routes(
             raise HTTPException(status_code=404, detail="Requires a transformation service.")
         return {"rows": to_jsonable(resolved_reporting_service.get_contract_renewal_watchlist())}
 
+    # ------------------------------------------------------------------
+    # Attention item -> the source record that owns it, resolved whole:
+    # an opaque id may contain a slash.
+    # ------------------------------------------------------------------
+
+    def _source_record(item_type: str, item_id: str) -> dict[str, Any]:
+        if resolved_reporting_service is None:
+            raise HTTPException(status_code=404, detail="Requires a transformation service.")
+        try:
+            rows = resolved_reporting_service.get_attention_record(item_type, item_id)
+        except AttentionRecordUnavailableError:
+            raise HTTPException(
+                status_code=503,
+                detail="The source publication cannot prove this attention item is absent.",
+            ) from None
+        except AttentionRecordNotFoundError:
+            raise HTTPException(
+                status_code=404, detail="No source record has this attention item id."
+            ) from None
+        return {"item_id": item_id, "rows": to_jsonable(rows)}
+
+    def _register_record_route(item_type: str, segment: str) -> None:
+        async def get_record(item_id: str) -> dict[str, Any]:
+            return _source_record(item_type, item_id)
+
+        app.get(
+            f"/reports/{segment}/records/{{item_id:path}}",
+            response_model=ATTENTION_RECORD_RESPONSE_MODELS[segment],
+            name=f"get_{item_type}_record",
+        )(get_record)
+
+    for _item_type, _segment in (
+        ("anomaly", "transaction-anomalies"),
+        ("contract_review", "contract-review-candidates"),
+        ("contract_renewal", "contract-renewal-watchlist"),
+        ("upcoming_cost", "upcoming-fixed-costs"),
+    ):
+        _register_record_route(_item_type, _segment)
+
     # ------------------------------------------------------------------
     # Budget: dedicated endpoints
     # ------------------------------------------------------------------
