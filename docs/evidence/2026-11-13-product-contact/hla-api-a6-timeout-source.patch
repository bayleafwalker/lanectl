diff --git a/packages/pipelines/reporting_attention_records.py b/packages/pipelines/reporting_attention_records.py
new file mode 100644
index 0000000..5f6db1f
--- /dev/null
+++ b/packages/pipelines/reporting_attention_records.py
@@ -0,0 +1,108 @@
+"""Attention item ids and the source publications that own them.
+
+An attention id is opaque and built from a row's identity columns, so it can
+contain slashes and cover several rows. The whole id is bound at the source.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any
+
+from packages.domains.finance.pipelines.subscription_models import (
+    MART_UPCOMING_FIXED_COSTS_30D_TABLE,
+)
+from packages.domains.finance.pipelines.transaction_models import (
+    MART_TRANSACTION_ANOMALIES_CURRENT_TABLE,
+)
+from packages.domains.utilities.pipelines.utility_models import (
+    MART_CONTRACT_RENEWAL_WATCHLIST_TABLE,
+    MART_CONTRACT_REVIEW_CANDIDATES_TABLE,
+)
+
+
+@dataclass(frozen=True)
+class AttentionSourceRecord:
+    """Source relation, key expression, and identity columns for one type.
+
+    A NULL or empty identity component makes a key fabricated.
+    """
+
+    item_type: str
+    relation_name: str
+    key_expression: str
+    identity_columns: tuple[str, ...]
+    order_by: str
+
+
+ATTENTION_SOURCE_RECORDS_BY_TYPE: dict[str, AttentionSourceRecord] = {
+    "anomaly": AttentionSourceRecord(
+        "anomaly", MART_TRANSACTION_ANOMALIES_CURRENT_TABLE,
+        "'anomaly_' || transaction_id", ("transaction_id",),
+        "booking_date DESC, transaction_id",
+    ),
+    "contract_review": AttentionSourceRecord(
+        "contract_review", MART_CONTRACT_REVIEW_CANDIDATES_TABLE,
+        "'review_' || contract_id || '_' || reason", ("contract_id", "reason"),
+        "score DESC, contract_id",
+    ),
+    "contract_renewal": AttentionSourceRecord(
+        "contract_renewal", MART_CONTRACT_RENEWAL_WATCHLIST_TABLE,
+        "'renewal_' || contract_id || '_' || CAST(renewal_date AS VARCHAR)",
+        ("contract_id", "renewal_date"), "renewal_date, contract_id",
+    ),
+    "upcoming_cost": AttentionSourceRecord(
+        "upcoming_cost", MART_UPCOMING_FIXED_COSTS_30D_TABLE,
+        "'upcoming_' || charge_id || '_' || CAST(expected_date AS VARCHAR)",
+        ("charge_id", "expected_date"), "expected_date, contract_name",
+    ),
+}
+
+
+class AttentionRecordNotFoundError(LookupError):
+    """The id is provably absent from the source publication."""
+
+
+class AttentionRecordUnavailableError(RuntimeError):
+    """The source cannot prove absence: unpublished, or unkeyed rows exist."""
+
+
+def attention_key_is_intact(record: AttentionSourceRecord, row: dict[str, Any]) -> bool:
+    for column in record.identity_columns:
+        value = row.get(column)
+        if value is None or (isinstance(value, str) and not value):
+            return False
+    return True
+
+
+def attention_column_names_query(
+    record: AttentionSourceRecord, *, placeholder: str
+) -> tuple[str, list[str]]:
+    return (
