+    def get_attention_record(self, item_type: str, item_id: str) -> list[dict[str, Any]]:
+        """Resolve one opaque attention id to the source rows it names.
+
+        The whole id is compared at the source with the relation's own key
+        expression; ``PUBLISHED`` reads only the source publication, and a
+        missing relation/column or NULL/empty identity cannot prove absence.
+        """
+        record = ATTENTION_SOURCE_RECORDS_BY_TYPE.get(item_type)
+        if record is None:
+            raise AttentionRecordNotFoundError(item_type)
+        fetch, placeholder = self._attention_record_source(record)
+
+        def query(sql: str, params: list[Any]) -> list[dict[str, Any]]:
+            try:
+                return fetch(sql, params)
+            except Exception as exc:
+                # An unexecutable key query also cannot prove absence; never
+                # surface a driver error as a 500.
+                raise AttentionRecordUnavailableError(record.relation_name) from exc
+
+        columns_sql, columns_params = attention_column_names_query(record, placeholder=placeholder)
+        columns = {str(row["column_name"]) for row in query(columns_sql, columns_params)}
+        if not set(record.identity_columns) <= columns:
+            raise AttentionRecordUnavailableError(record.relation_name)
+        sql, params = attention_record_query(record, item_id, placeholder=placeholder)
+        rows = query(sql, params)
+        if rows:
+            if not all(attention_key_is_intact(record, row) for row in rows):
+                raise AttentionRecordUnavailableError(record.relation_name)
+            return rows
+        probe_sql, probe_params = attention_identity_probe_query(record)
+        unkeyed = query(probe_sql, probe_params)
+        if unkeyed and int(unkeyed[0]["unkeyed_rows"]) > 0:
+            raise AttentionRecordUnavailableError(record.relation_name)
+        raise AttentionRecordNotFoundError(item_type)
