+def attention_record_query(
+    record: AttentionSourceRecord, item_id: str, *, placeholder: str
+) -> tuple[str, list[str]]:
+    return (
+        f"SELECT * FROM {record.relation_name}"
+        f" WHERE {record.key_expression} = {placeholder}"
+        f" ORDER BY {record.order_by}"
+    ), [item_id]
