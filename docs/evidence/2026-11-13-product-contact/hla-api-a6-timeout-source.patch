+def attention_identity_probe_query(
+    record: AttentionSourceRecord,
+) -> tuple[str, list[str]]:
+    unusable = " OR ".join(
+        f"{column} IS NULL OR CAST({column} AS VARCHAR) = ''"
+        for column in record.identity_columns
+    )
+    return (
+        f"SELECT COUNT(*) AS unkeyed_rows FROM {record.relation_name}"
+        f" WHERE {unusable}"
+    ), []
