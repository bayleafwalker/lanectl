+        def read_warehouse(sql: str, params: list[Any]) -> list[dict[str, Any]]:
+            return run_on_warehouse(
+                self._transformation_service,
+                f"attention_record.{record.relation_name}",
+                lambda store: store.fetchall_dicts(sql, params),
+                write=False,
+            )
+
