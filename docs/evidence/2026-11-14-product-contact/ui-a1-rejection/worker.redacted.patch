+// Pure-logic self-check for the current-report attention helpers. Run under
+// Node by tests/test_attention_ui_worker.py; loads lib/attention.js as-is and
+// asserts ranking, severity metadata and strict base64url key handling. This is
+// the pure-transform boundary where NaN may be exercised (it is not valid JSON
+// and never reaches an HTTP fixture).
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { dirname, resolve } from "node:path";
+import { strict as assert } from "node:assert";
+
+const here = dirname(fileURLToPath(import.meta.url));
+const source = readFileSync(resolve(here, "../lib/attention.js"), "utf8");
+const commonJs = source.replace(/^export /gm, "");
+const factory = new Function(
+  "TextEncoder",
+  "TextDecoder",
+  commonJs +
+    "\nreturn { ATTENTION_KINDS, encodeAttentionKey, decodeAttentionKey, attentionSeverityMeta, rankAttentionItems };"
+);
+const api = factory(TextEncoder, TextDecoder);
+
+// Whole-key encoding must match Node's unpadded base64url exactly (the same
+// bytes the acceptance oracle derives from urlsafe_b64encode without padding).
+for (const value of [
+  "review_grid/north_above_market_average",
+  "anomaly_opaque/1_ä",
+  "contract_opaque/雪_underscore",
+  "upcoming_charge-42_2026-05-07",
+]) {
+  assert.equal(api.encodeAttentionKey(value), Buffer.from(value, "utf8").toString("base64url"));
+  assert.equal(api.decodeAttentionKey(api.encodeAttentionKey(value)), value);
+}
+
+// Strict/canonical decode rejects padding, non-canonical tail bits, invalid
+// characters, empty input and non-UTF-8 bytes.
+assert.equal(api.decodeAttentionKey("YQ"), "a");
+assert.equal(api.decodeAttentionKey("YQ=="), null);
+assert.equal(api.decodeAttentionKey("YR"), null);
+assert.equal(api.decodeAttentionKey("%%%"), null);
+assert.equal(api.decodeAttentionKey(""), null);
+assert.equal(api.decodeAttentionKey(Buffer.from([0xff, 0xfe]).toString("base64url")), null);
+
+// Severity metadata: 3 urgent/warn, 2 soon/warm, 1 watch/neutral; everything
+// else (missing, null, numeric strings, nonnumeric, unsupported numbers, NaN)
+// is Unknown/neutral.
+assert.deepEqual(api.attentionSeverityMeta(3), { tone: "warn", label: "urgent" });
+assert.deepEqual(api.attentionSeverityMeta(2), { tone: "warm", label: "soon" });
+assert.deepEqual(api.attentionSeverityMeta(1), { tone: "neutral", label: "watch" });
+for (const unknown of [null, "3", 8, "bad", NaN, undefined, 0, -1, 1.5]) {
+  assert.deepEqual(api.attentionSeverityMeta(unknown), { tone: "neutral", label: "unknown" });
+}
+
+// Stable descending rank, ties in input order, unknown last in input order.
+const mixed = [1, 3, 2, 1, 3, 2, 3, 1, 2, 3, 2, null].map((severity, i) => ({ i, severity }));
+assert.deepEqual(api.rankAttentionItems(mixed).map((r) => r.i), [1, 4, 6, 9, 2, 5, 8, 10, 0, 3, 7, 11]);
+
+const unknowns = [
+  { i: 100, severity: null },
+  { i: 101, severity: "3" },
+  { i: 102, severity: 8 },
+  { i: 103, severity: 1 },
+  { i: 104, severity: "bad" },
+  { i: 105 },
+];
+assert.deepEqual(api.rankAttentionItems(unknowns).map((r) => r.i), [103, 100, 101, 102, 104, 105]);
+
+// NaN is only ever a pure-transform control: it ranks Unknown and never
+// changes the known labels.
+assert.deepEqual(api.attentionSeverityMeta(NaN).label, "unknown");
+assert.equal(api.rankAttentionItems([{ i: 0, severity: NaN }, { i: 1, severity: 3 }])[0].i, 1);
+
+console.log("attention worker self-check OK");
