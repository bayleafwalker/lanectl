@@ -0,0 +1,47 @@
+import { AppShell } from "@/components/app-shell";
+import { AttentionRecordView } from "@/components/attention-record-view";
+import { StatePanel } from "@/components/state-panel";
+import { getAttentionRecord, getCurrentUser } from "@/lib/backend";
+import { ATTENTION_KINDS, decodeAttentionKey } from "@/lib/attention";
+
+// Invalid kinds and non-canonical keys are a current-report not-found: safe
+// copy, no backend lookup, never routed to the source reader.
+function CurrentReportNotFound() {
+  return (
+    <main className="standalonePage" id="main-content">
+      <a href="/" className="wordmark">
+        Kotona
+      </a>
+      <StatePanel tone="empty" title="Not found in the current report">
+        <p>This record is not part of the current report.</p>
+      </StatePanel>
+    </main>
+  );
+}
+
+// Individual current-report record. The kind is allowlisted and the route key
+// is decoded strictly/canonically before any backend read.
+export default async function AttentionRecordPage({ params }) {
+  const { kind, key } = params;
+  const itemId = Object.prototype.hasOwnProperty.call(ATTENTION_KINDS, kind)
+    ? decodeAttentionKey(key)
+    : null;
+  if (itemId === null) {
+    return <CurrentReportNotFound />;
+  }
+
+  const user = await getCurrentUser();
+  const record = await getAttentionRecord(kind, itemId);
+
+  return (
+    <AppShell
+      currentPath="/operating-picture"
+      user={user}
+      title="Current report"
+      eyebrow="Operating picture"
+      lede="One attention record from the current report."
+    >
+      <AttentionRecordView kind={kind} record={record} />
+    </AppShell>
+  );
+}
