diff --git a/apps/web/frontend/lib/attention.js b/apps/web/frontend/lib/attention.js
new file mode 100644
index 0000000..fb90d13
--- /dev/null
+++ b/apps/web/frontend/lib/attention.js
@@ -0,0 +1,103 @@
+// Pure helpers for the Operating Picture current-report attention surface.
+//
+// Kept free of Next.js and backend imports so the view component renders in
+// Storybook (browser) and the ranking/encoding logic is testable in isolation.
+// The whole item_id is a single opaque UTF-8 key; routes carry it as unpadded
+// base64url and decode it strictly and canonically on the server.
+
+export const ATTENTION_KINDS = Object.freeze({
+  anomaly: "transaction-anomalies",
+  upcoming_cost: "upcoming-fixed-costs",
+  contract_review: "contract-review-candidates",
+  contract_renewal: "contract-renewal-watchlist",
+});
+
+const B64URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+
+function bytesToBase64Url(bytes) {
+  let acc = 0;
+  let bits = 0;
+  let out = "";
+  for (let i = 0; i < bytes.length; i += 1) {
+    acc = (acc << 8) | bytes[i];
+    bits += 8;
+    while (bits >= 6) {
+      bits -= 6;
+      out += B64URL[(acc >> bits) & 63];
+    }
+    acc &= (1 << bits) - 1;
+  }
+  if (bits > 0) {
+    out += B64URL[(acc << (6 - bits)) & 63];
+  }
+  return out;
+}
+
+function base64UrlToBytes(value) {
+  let acc = 0;
+  let bits = 0;
+  const bytes = [];
+  for (let i = 0; i < value.length; i += 1) {
+    const code = B64URL.indexOf(value[i]);
+    if (code === -1) return null;
+    acc = (acc << 6) | code;
+    bits += 6;
+    if (bits >= 8) {
+      bits -= 8;
+      bytes.push((acc >> bits) & 0xff);
+      acc &= (1 << bits) - 1;
+    }
+  }
+  return bytes;
+}
+
+// Whole UTF-8 item_id -> unpadded base64url route key.
+export function encodeAttentionKey(itemId) {
+  return bytesToBase64Url(new TextEncoder().encode(String(itemId)));
+}
+
+// Strict, canonical decode: valid unpadded base64url that round-trips and is
+// valid UTF-8. Rejects padding, unknown characters, and non-canonical tail
+// bits (for example "YR" for "a") so nothing reaches the source lookup.
+export function decodeAttentionKey(key) {
+  if (typeof key !== "string" || key.length === 0) return null;
+  if (!/^[A-Za-z0-9_-]+$/.test(key)) return null;
+  if (key.length % 4 === 1) return null;
+  const bytes = base64UrlToBytes(key);
+  if (!bytes) return null;
+  if (bytesToBase64Url(bytes) !== key) return null;
+  try {
+    return new TextDecoder("utf-8", { fatal: true }).decode(new Uint8Array(bytes));
+  } catch {
+    return null;
+  }
+}
+
+// 3 urgent (warn), 2 soon (warm), 1 watch (neutral); anything else — missing,
+// null, numeric strings, nonnumeric, unsupported numbers — is Unknown/neutral.
+export function attentionSeverityMeta(severity) {
+  if (severity === 3) return { tone: "warn", label: "urgent" };
+  if (severity === 2) return { tone: "warm", label: "soon" };
+  if (severity === 1) return { tone: "neutral", label: "watch" };
+  return { tone: "neutral", label: "unknown" };
+}
+
+function severityRank(severity) {
+  if (severity === 3) return 0;
+  if (severity === 2) return 1;
+  if (severity === 1) return 2;
+  return 3;
+}
+
+// Stable descending priority (3, 2, 1) with original input order preserved for
+// ties; every unsupported value ranks last in input order.
+export function rankAttentionItems(items) {
+  return items
+    .map((item, index) => ({ item, index }))
+    .sort(
+      (a, b) =>
+        severityRank(a.item.severity) - severityRank(b.item.severity) ||
+        a.index - b.index
+    )
+    .map(({ item }) => item);
+}
diff --git a/apps/web/frontend/lib/backend.ts b/apps/web/frontend/lib/backend.ts
index 0a230a2..9d91783 100755
--- a/apps/web/frontend/lib/backend.ts
+++ b/apps/web/frontend/lib/backend.ts
@@ -627,6 +627,81 @@ export async function getAttentionItems() {
   const payload = await backendGet("/reports/attention-items");
   return getResponseArray(payload, "rows");
 }
+
+// Current-report attention feed read. Unlike getAttentionItems, this keeps the
+// raw rows-array shape so the Operating Picture can tell a successful empty
+// feed apart from a missing/null/non-array (malformed) or failed (unavailable)
+// response; none of those may be coerced to "all clear".
+export type AttentionFeedResult =
+  | { status: "ok"; rows: Array<{ item_id?: unknown } & Record<string, unknown>> }
+  | { status: "unavailable" }
+  | { status: "malformed" };
+
+export async function getAttentionFeed(): Promise<AttentionFeedResult> {
+  const { response, data } = await backendJsonRequest("get", "/reports/attention-items");
+  if (response.status === 401) {
+    redirect("/login");
+  }
+  if (!response.ok) {
+    return { status: "unavailable" };
+  }
+  if (!data || !Array.isArray(data.rows)) {
+    return { status: "malformed" };
+  }
+  return { status: "ok", rows: data.rows };
+}
+
+const ATTENTION_RECORD_PATHS = {
+  anomaly: "/reports/transaction-anomalies/records/{item_id}",
+  upcoming_cost: "/reports/upcoming-fixed-costs/records/{item_id}",
+  contract_review: "/reports/contract-review-candidates/records/{item_id}",
+  contract_renewal: "/reports/contract-renewal-watchlist/records/{item_id}",
+} as const;
+
+export type AttentionRecordKind = keyof typeof ATTENTION_RECORD_PATHS;
+
+export type AttentionRecordResult =
+  | { status: "ok"; itemId: string; rows: unknown[] }
+  | { status: "denied" }
+  | { status: "not_found" }
+  | { status: "unavailable"; retryAfter: string | null };
+
+// Narrow, kind-dispatched record read on the existing authenticated client.
+// 401 redirects to login, 403/404/503 resolve to controlled states, and any
+// other failure (including 500) throws so the route's error boundary renders.
+// The decoded whole item_id is sent once as a typed path parameter.
+export async function getAttentionRecord(
+  kind: AttentionRecordKind,
+  itemId: string
+): Promise<AttentionRecordResult> {
+  const path = ATTENTION_RECORD_PATHS[kind];
+  const { response, data } = await backendJsonRequest("get", path, {
+    params: { path: { item_id: itemId } },
+  });
+  if (response.status === 401) {
+    redirect("/login");
+  }
+  if (response.status === 403) {
+    return { status: "denied" };
+  }
+  if (response.status === 404) {
+    return { status: "not_found" };
+  }
+  if (response.status === 503) {
+    return { status: "unavailable", retryAfter: response.headers.get("retry-after") };
+  }
+  if (!response.ok) {
+    throw new Error(
+      `Unexpected error loading attention record ${path}: ${response.status}`
+    );
+  }
+  const body = data as { item_id?: string; rows?: unknown[] } | null;
+  return {
+    status: "ok",
+    itemId: body?.item_id ?? itemId,
+    rows: Array.isArray(body?.rows) ? body.rows : [],
+  };
+}
 export async function getRecentChanges() {
   const payload = await backendGet("/reports/recent-changes");
   return getResponseArray(payload, "rows");
diff --git a/apps/web/frontend/middleware.js b/apps/web/frontend/middleware.js
new file mode 100644
index 0000000..6c42291
--- /dev/null
+++ b/apps/web/frontend/middleware.js
@@ -0,0 +1,19 @@
+import { NextResponse } from "next/server";
+
+// Intercept attention record routes whose URL carries a raw, malformed
+// percent-encoding. Next's router rejects those with a bare 400 before the
+// page runs; a current-report not-found is the correct public answer and
+// must never reach the source reader.
+export function middleware(request) {
+  const raw = request.url.split("?")[0];
+  if (/\/operating-picture\/attention\//.test(raw) && /%(?![0-9a-fA-F]{2})/.test(raw)) {
+    return NextResponse.rewrite(
+      new URL("/operating-picture/attention/not-a-kind/invalid", request.url)
+    );
+  }
+  return NextResponse.next();
+}
+
+export const config = {
+  matcher: ["/operating-picture/attention/:path*"],
+};
