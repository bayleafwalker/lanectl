+}
+
+// Presentational view for one current-report attention record. `record` is the
+// discriminated result of the narrow transport: ok carries source rows, and
+// the four non-happy states map to distinct safe copy without any source facts.
+export function AttentionRecordView({ kind, record }) {
+  return (
+    <section className="stack">
+      <article className="panel section">
+        <div className="sectionHeader">
+          <div>
+            <Eyebrow>Current report</Eyebrow>
+            <h2>{KIND_LABELS[kind] || "Record"}</h2>
+          </div>
+          <a className="inlineLink" href="/operating-picture">
+            Back to operating picture →
+          </a>
+        </div>
+
+        {record.status === "ok" ? (
+          record.rows.length > 0 ? (
+            <RecordFacts kind={kind} rows={record.rows} />
+          ) : (
+            <StatePanel tone="empty" title="No record rows">
+              <p>This record has no source rows in the current report.</p>
+            </StatePanel>
+          )
+        ) : record.status === "denied" ? (
+          <StatePanel tone="error" title="Access denied">
+            <p>Your account does not have access to this record.</p>
+          </StatePanel>
+        ) : record.status === "not_found" ? (
+          <StatePanel tone="empty" title="Not found in the current report">
+            <p>This record is not part of the current report.</p>
+          </StatePanel>
+        ) : (
+          <StatePanel tone="error" title="Source unavailable">
+            <p>
+              The source for this record is temporarily unavailable.
+              {record.retryAfter ? " Try again shortly." : ""}
+            </p>
+          </StatePanel>
+        )}
+      </article>
+    </section>
+  );
+}
