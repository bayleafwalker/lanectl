+"""Worker tests for the current-report attention frontend helpers.
+
+These exercise the pure transform boundary (ranking, severity metadata and
+strict base64url key encoding) by running the actual ``lib/attention.js`` under
+Node, so the tests fail if the frontend helpers are absent or wrong. The
+planner-owned browser acceptance stays in test_attention_current_ui_acceptance.py.
+"""
+from __future__ import annotations
+
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+SCRIPT = ROOT / "apps" / "web" / "frontend" / "scripts" / "attention-worker-check.mjs"
+
+
+def _node_bin() -> str:
+    node = shutil.which("node")
+    if node is not None:
+        return node
+    pytest.fail("node is required to run the attention worker self-check; no skip")
+
+
+def test_attention_helpers_rank_and_encode_keys_canonically() -> None:
+    assert SCRIPT.is_file(), f"missing self-check script: {SCRIPT}"
+    result = subprocess.run(
+        [_node_bin(), str(SCRIPT)],
+        capture_output=True,
+        text=True,
+        timeout=60,
+    )
+    assert result.returncode == 0, (
+        f"attention worker self-check failed: {result.stderr or result.stdout}"
+    )
+    assert "attention worker self-check OK" in result.stdout
+
+
+def test_attention_ui_contracts_are_frozen_verbatim() -> None:
+    import hashlib
+
+    expected = {
+        "intent.md": "fb195a7c65517da1c0b4781759f1f89fb636f759e90b7befca55f788e9cb1f85",
+        "baseline.tokens.json": "[verified public file checksum omitted; see patch-redaction.json]",
+        "ui-contract.yaml": "603153cffbf78388d003a30387d4a2db63a3e4289da0e18a96fa934bc6392ee1",
+    }
+    contract_dir = ROOT / "apps" / "web" / "frontend" / "ui-contracts" / "attention-current-report"
+    for name, digest in expected.items():
+        path = contract_dir / name
+        assert path.is_file(), f"missing frozen contract artifact: {path}"
+        assert hashlib.sha256(path.read_bytes()).hexdigest() == digest, name
