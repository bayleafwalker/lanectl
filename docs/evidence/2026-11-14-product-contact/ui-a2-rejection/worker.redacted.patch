diff --git a/apps/web/frontend/components/attention-record-link.js b/apps/web/frontend/components/attention-record-link.js
new file mode 100644
index 0000000..005e830
--- /dev/null
+++ b/apps/web/frontend/components/attention-record-link.js
@@ -0,0 +1,19 @@
+"use client";
+
+import React from "react";
+import Link from "next/link";
+
+// One record destination per row. The address commits before Next starts the
+// transition, so keyboard/pointer activation, deep links and reloads agree.
+export function AttentionRecordLink({ href, children }) {
+  function commit(event) {
+    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button > 0) return;
+    window.history.replaceState(null, "", href);
+  }
+  return (
+    <Link className="inlineLink" href={href} prefetch={false} onClick={commit}
+      onKeyDown={(event) => { if (event.key === "Enter") commit(event); }}>
+      {children}
+    </Link>
+  );
+}
