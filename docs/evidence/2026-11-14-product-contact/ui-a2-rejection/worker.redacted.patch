+++ b/tests/test_attention_current_ui.py
@@ -0,0 +1,67 @@
+"""Worker-authored checks for the pure current-report attention helpers."""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+FRONTEND = ROOT / "apps" / "web" / "frontend"
+LIB = FRONTEND / "lib" / "attention.js"
+NODE = shutil.which("node")
+
+
+def run(expression: str):
+    assert NODE, "node is required to exercise the pure attention helpers"
+    script = f"import * as a from {json.dumps(LIB.as_uri())};console.log(JSON.stringify(({expression})(a)));"
+    result = subprocess.run([NODE, "--input-type=module", "-e", script],
+                            capture_output=True, text=True, timeout=30, check=False)
+    assert result.returncode == 0, result.stderr[-2000:]
+    return json.loads(result.stdout)
+
+
+def test_rank_is_numeric_severity_first_stable_and_unknown_last() -> None:
+    severities = [1, 3, 2, 1, 3, 2, 3, 1, 2, 3, 2, None]
+    items = [{"item_id": f"i{i}", "severity": value} for i, value in enumerate(severities)]
+    ranked = run(f"(a) => a.rankAttentionItems({json.dumps(items)})")
+    assert [row["item_id"] for row in ranked[:8]] == ["i1", "i4", "i6", "i9", "i2", "i5", "i8", "i10"]
+    assert [row["priority"]["label"] for row in ranked[:8]] == ["Urgent"] * 4 + ["Soon"] * 4
+    assert ranked[-1]["priority"] == {"rank": 0, "label": "Unknown", "tone": "neutral"}
+    odd = [{"item_id": "watch", "severity": 1}, {"item_id": "null", "severity": None},
+           {"item_id": "numeric-string", "severity": "3"}, {"item_id": "unsupported", "severity": 8},
+           {"item_id": "nonnumeric", "severity": "bad"}, {"item_id": "missing"}]
+    labels = run(f"(a) => a.rankAttentionItems({json.dumps(odd)}).map((r) => [r.item_id, r.priority.label])")
+    assert labels == [["watch", "Watch"], ["null", "Unknown"], ["numeric-string", "Unknown"],
+                      ["unsupported", "Unknown"], ["nonnumeric", "Unknown"], ["missing", "Unknown"]]
+
+
+def test_nan_is_neutral_only_at_the_pure_boundary() -> None:
+    result = run("(a) => a.rankAttentionItems([{item_id:'nan',severity:NaN},{item_id:'soon',severity:2}])"
+                 ".map((r) => [r.item_id, r.priority.label])")
+    assert result == [["soon", "Soon"], ["nan", "Unknown"]]
+
+
+def test_whole_utf8_identifier_round_trips_through_canonical_unpadded_key() -> None:
+    item_id = "contract_opaque/\u96ea_underscore"
+    key = run(f"(a) => a.encodeAttentionKey({json.dumps(item_id)})")
+    assert re.fullmatch(r"[A-Za-z0-9_-]+", key) and "=" not in key
+    assert run(f"(a) => a.decodeAttentionKey({json.dumps(key)})") == item_id
+    assert run(f"(a) => a.parseAttentionRoute('contract_review', {json.dumps(key)})") == {
+        "kind": "contract_review", "itemId": item_id, "segment": "contract-review-candidates"}
+    for broken in (key + "=", "YQ==", "YR", "%%%", "", "not+a+key"):
+        assert run(f"(a) => a.decodeAttentionKey({json.dumps(broken)})") is None
+    assert run("(a) => a.parseAttentionRoute('not-a-kind', 'YQ')") is None
+
+
+def test_published_contracts_are_the_frozen_originals() -> None:
+    directory = FRONTEND / "ui-contracts" / "attention-current-report"
+    expected = {
+        "intent.md": "fb195a7c65517da1c0b4781759f1f89fb636f759e90b7befca55f788e9cb1f85",
+        "baseline.tokens.json": "[verified public file checksum omitted; see patch-redaction.json]",
+        "ui-contract.yaml": "603153cffbf78388d003a30387d4a2db63a3e4289da0e18a96fa934bc6392ee1",
+    }
+    for name, digest in expected.items():
+        assert hashlib.sha256((directory / name).read_bytes()).hexdigest() == digest
