diff --git a/apps/web/frontend/lib/attention.js b/apps/web/frontend/lib/attention.js
new file mode 100644
index 0000000..0c79055
--- /dev/null
+++ b/apps/web/frontend/lib/attention.js
@@ -0,0 +1,81 @@
+// Current-report attention helpers shared by the queue, the record route and
+// their pure-JS tests. No data access happens here.
+
+export const ATTENTION_KINDS = Object.freeze({
+  anomaly: "transaction-anomalies",
+  upcoming_cost: "upcoming-fixed-costs",
+  contract_review: "contract-review-candidates",
+  contract_renewal: "contract-renewal-watchlist",
+});
+
+const UNKNOWN = Object.freeze({ rank: 0, label: "Unknown", tone: "neutral" });
+const PRIORITIES = Object.freeze({
+  3: { rank: 3, label: "Urgent", tone: "warn" },
+  2: { rank: 2, label: "Soon", tone: "warm" },
+  1: { rank: 1, label: "Watch", tone: "neutral" },
+});
+
+// Only numeric 1/2/3 are known: numeric strings, NaN and unsupported numbers
+// stay Unknown rather than being coerced.
+export function attentionPriority(severity) {
+  return typeof severity === "number" && PRIORITIES[severity] ? PRIORITIES[severity] : UNKNOWN;
+}
+
+// Rank before any top-eight limit; ties and Unknowns keep input order.
+export function rankAttentionItems(items) {
+  return items
+    .map((item, index) => ({ item, index, priority: attentionPriority(item.severity) }))
+    .sort((left, right) => right.priority.rank - left.priority.rank || left.index - right.index)
+    .map((entry) => ({ ...entry.item, priority: entry.priority }));
+}
+
+function toBase64Url(bytes) {
+  let binary = "";
+  for (const byte of bytes) binary += String.fromCharCode(byte);
+  return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+}
+
+export function encodeAttentionKey(itemId) {
+  return toBase64Url(new TextEncoder().encode(String(itemId)));
+}
+
+const CANONICAL_KEY = /^[A-Za-z0-9_-]+$/;
+
+// Strict canonical unpadded base64url -> whole UTF-8 id. Padding, foreign
+// alphabets, non-canonical trailing bits and invalid UTF-8 are all rejected.
+export function decodeAttentionKey(key) {
+  if (typeof key !== "string" || !CANONICAL_KEY.test(key) || key.length % 4 === 1) return null;
+  let binary;
+  try {
+    binary = atob(key.replace(/-/g, "+").replace(/_/g, "/") + "=".repeat((4 - (key.length % 4)) % 4));
+  } catch {
+    return null;
+  }
+  const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
+  if (toBase64Url(bytes) !== key) return null;
+  try {
+    return new TextDecoder("utf-8", { fatal: true }).decode(bytes);
+  } catch {
+    return null;
+  }
+}
+
+export function parseAttentionRoute(kind, key) {
+  if (typeof kind !== "string" || !Object.hasOwn(ATTENTION_KINDS, kind)) return null;
+  const itemId = decodeAttentionKey(key);
+  return itemId ? { kind, itemId, segment: ATTENTION_KINDS[kind] } : null;
+}
+
+// A row without an allowlisted kind and non-empty whole id makes the feed
+// malformed rather than quietly empty.
+export function normalizeAttentionItems(rows) {
+  if (!Array.isArray(rows)) return null;
+  const items = [];
+  for (const row of rows) {
+    if (!row || typeof row !== "object") return null;
+    if (typeof row.item_id !== "string" || !row.item_id) return null;
+    if (typeof row.item_type !== "string" || !Object.hasOwn(ATTENTION_KINDS, row.item_type)) return null;
+    items.push({ ...row });
+  }
+  return items;
+}
