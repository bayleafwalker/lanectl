+
+const ATTENTION_RECORD_PATHS = {
+  anomaly: "/reports/transaction-anomalies/records/{item_id}",
+  upcoming_cost: "/reports/upcoming-fixed-costs/records/{item_id}",
+  contract_review: "/reports/contract-review-candidates/records/{item_id}",
+  contract_renewal: "/reports/contract-renewal-watchlist/records/{item_id}"
+} as const;
+export type AttentionKind = keyof typeof ATTENTION_RECORD_PATHS;
+export type AttentionFeedResult =
+  | { status: "ok"; rows: components["schemas"]["AttentionItemRow"][] }
+  | { status: "denied" }
+  | { status: "unavailable" };
+export type AttentionRecordResult =
+  | { status: "ok"; itemId: string; rows: unknown[] }
+  | { status: "denied" | "absent" | "unavailable" };
+
+function rowsFrom(payload: unknown): unknown[] | null {
+  if (!payload || typeof payload !== "object") return null;
+  const rows = (payload as { rows?: unknown }).rows;
+  return Array.isArray(rows) ? rows : null;
+}
+
+function attentionFailure(status: number): "denied" | "absent" | "unavailable" | null {
+  if (status === 401) redirect("/login");
+  if (status === 403) return "denied";
+  if (status === 404) return "absent";
+  return status === 503 ? "unavailable" : null;
+}
+
+// Narrow current-report transport. It owns the public outcomes and never
+// falls back to another report, list or source.
+export async function getAttentionFeed(): Promise<AttentionFeedResult> {
+  let result;
+  try {
+    result = await createBackendClient().GET("/reports/attention-items");
+  } catch {
+    return { status: "unavailable" };
+  }
+  const failure = attentionFailure(result.response.status);
+  if (failure) return { status: failure === "denied" ? "denied" : "unavailable" };
+  if (!result.response.ok) {
+    throw new Error(`Backend request failed for /reports/attention-items: ${result.response.status}`);
+  }
+  const rows = rowsFrom(result.data);
+  return rows
+    ? { status: "ok", rows: rows as components["schemas"]["AttentionItemRow"][] }
+    : { status: "unavailable" };
+}
+
+export async function getAttentionRecord(
+  kind: AttentionKind,
+  itemId: string
+): Promise<AttentionRecordResult> {
+  const path = ATTENTION_RECORD_PATHS[kind];
+  let result;
+  try {
+    result = await createBackendClient().GET(path, { params: { path: { item_id: itemId } } });
+  } catch {
+    return { status: "unavailable" };
+  }
+  const failure = attentionFailure(result.response.status);
+  if (failure) return { status: failure };
+  if (!result.response.ok) {
+    throw new Error(`Backend request failed for ${path}: ${result.response.status}`);
+  }
+  const rows = rowsFrom(result.data);
+  return rows && rows.length > 0
+    ? { status: "ok", itemId, rows }
+    : { status: "unavailable" };
+}
+
 export async function getRecentChanges() {
   const payload = await backendGet("/reports/recent-changes");
   return getResponseArray(payload, "rows");
