+const { test, expect } = require("@playwright/test");
+const AxeBuilder = require("@axe-core/playwright").default;
+
+async function gotoStory(page, storyId) {
+  await page.goto(`/iframe.html?id=${storyId}&viewMode=story&globals=a11y.manual:!true`);
+  await expect(page.locator("#storybook-root")).toBeVisible();
+  await expect(page.locator("#storybook-root")).not.toContainText(
+    "The component failed to render properly"
+  );
+}
+
+async function accessible(page) {
+  const results = await new AxeBuilder({ page }).include("main").analyze();
+  expect(results.violations, results.violations.map((v) => `${v.id}: ${v.nodes.length}`).join("\n")).toEqual([]);
+}
+
+for (const kind of ["anomaly", "upcoming-cost", "contract-review", "contract-renewal"]) {
+  test(`attention record ${kind} keeps every row visible and accessible`, async ({ page }) => {
+    await gotoStory(page, `attention-record--${kind}`);
+    await expect(page.locator("main dl[data-record-row]").first()).toBeVisible();
+    await expect(page.getByText("Current report").first()).toBeVisible();
+    await accessible(page);
+  });
+}
+
+test("attention nulls say Unknown and failures stay distinct", async ({ page }) => {
+  await gotoStory(page, "attention-record--upcoming-cost");
+  await expect(page.locator("main dl[data-record-row]")).toHaveCount(2);
+  await expect(page.getByText("Unknown").first()).toBeVisible();
+  await gotoStory(page, "attention-record--failure-states");
+  for (const text of ["Access denied", "Record not found in the current report", "Source unavailable"]) {
+    await expect(page.getByText(text)).toBeVisible();
+  }
+  await expect(page.getByText("All clear")).toHaveCount(0);
+  await accessible(page);
+  await gotoStory(page, "operatingpicture-pagesnapshot--attention-unavailable");
+  await expect(page.getByText("Current report unavailable")).toBeVisible();
+  await expect(page.getByText("All clear")).toHaveCount(0);
+  await gotoStory(page, "operatingpicture-pagesnapshot--empty-state");
+  await expect(page.getByText("All clear")).toBeVisible();
+});
+
+test("attention record links are keyboard operable", async ({ page }) => {
+  await gotoStory(page, "operatingpicture-pagesnapshot--v-2-layout");
+  const link = page.locator(".attentionRow a").first();
+  await expect(link).toHaveAttribute("href", /^\/operating-picture\/attention\/[a-z_]+\/[A-Za-z0-9_-]+$/);
+  await link.focus();
+  await expect(link).toBeFocused();
+  expect(await link.evaluate((node) => node.tabIndex)).toBeGreaterThanOrEqual(0);
+});
+
+test("attention surfaces fit a narrow viewport", async ({ page }) => {
+  await page.setViewportSize({ width: 390, height: 844 });
+  for (const storyId of ["operatingpicture-pagesnapshot--v-2-layout", "attention-record--contract-renewal"]) {
+    await gotoStory(page, storyId);
+    const overflow = await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth);
+    expect(overflow, storyId).toBeLessThanOrEqual(1);
+  }
+  await expect(page.locator("main dl[data-record-row]").first()).toBeVisible();
+});
