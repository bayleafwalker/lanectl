+import React from "react";
+import Link from "next/link";
+
+import { Eyebrow } from "./eyebrow";
+import { StatePanel } from "./state-panel";
+
+const KINDS = {
+  anomaly: { heading: "Transaction anomaly", fields: [
+    ["Counterparty", "counterparty_name"], ["Booking date", "booking_date"], ["Amount", "amount"],
+    ["Direction", "direction"], ["Reason", "anomaly_reason"]] },
+  upcoming_cost: { heading: "Upcoming fixed cost", fields: [
+    ["Contract", "contract_name"], ["Provider", "provider"], ["Expected amount", "expected_amount"],
+    ["Currency", "currency"], ["Frequency", "frequency"], ["Expected date", "expected_date"],
+    ["Confidence", "confidence"]] },
+  contract_review: { heading: "Contract review candidate", fields: [
+    ["Provider", "provider"], ["Utility type", "utility_type"], ["Reason", "reason"],
+    ["Current price", "current_price"], ["Currency", "currency"], ["Market reference", "market_reference"]] },
+  contract_renewal: { heading: "Contract renewal", fields: [
+    ["Contract", "contract_name"], ["Provider", "provider"], ["Renewal date", "renewal_date"],
+    ["Days until renewal", "days_until_renewal"], ["Current price", "current_price"], ["Currency", "currency"]] },
+};
+
+const MESSAGES = {
+  denied: ["Access denied", "Your account may not read this source record in the current report. No other source was queried."],
+  absent: ["Record not found in the current report", "This key is absent from the current report. It may never have been current."],
+  unavailable: ["Source unavailable", "This source is temporarily unavailable, so the record cannot be shown right now. Try again later."],
+};
+
+// Values render exactly as published; null, undefined or empty says Unknown.
+function factText(value) {
+  return value === null || value === undefined || value === "" ? "Unknown" : String(value);
+}
+
+export function AttentionRecordView({ kind, state, rows = [] }) {
+  const meta = KINDS[kind];
+  return (
+    <section className="stack">
+      <div className="sectionHeader">
+        <div>
+          <Eyebrow>Current report</Eyebrow>
+          <h2>{meta.heading}</h2>
+        </div>
+        <Link className="inlineLink" href="/operating-picture" prefetch={false}>
+          ← Back to the operating picture
+        </Link>
+      </div>
+      {state === "ok" ? (
+        <div className="recordGrid">
+          {rows.map((row, index) => (
+            <dl className="panel section recordRow" data-record-row key={index}>
+              {meta.fields.map(([label, field]) => (
+                <div className="recordFact" key={field}>
+                  <dt>{label}</dt>
+                  <dd>{factText(row?.[field])}</dd>
+                </div>
+              ))}
+            </dl>
+          ))}
+        </div>
+      ) : (
+        <StatePanel tone="error" title={MESSAGES[state][0]}>
+          <p>{MESSAGES[state][1]}</p>
+        </StatePanel>
+      )}
+    </section>
+  );
+}
