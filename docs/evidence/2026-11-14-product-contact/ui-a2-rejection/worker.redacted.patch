--- /dev/null
+++ b/apps/web/frontend/middleware.js
@@ -0,0 +1,17 @@
+import { NextResponse } from "next/server";
+
+// A malformed percent escape would otherwise make Next answer a server-level
+// 400 before the dynamic record page runs. Rewrite it to one canonical
+// unsupported key so the current-report page renders its own not-found state.
+export function middleware(request) {
+  const { pathname } = request.nextUrl;
+  if (!pathname.startsWith("/operating-picture/attention/") || !/%(?![0-9A-Fa-f]{2})/.test(pathname)) {
+    return NextResponse.next();
+  }
+  const url = request.nextUrl.clone();
+  url.pathname = "/operating-picture/attention/anomaly/not-a-key";
+  url.search = "";
+  return NextResponse.rewrite(url);
+}
+
+export const config = { matcher: ["/operating-picture/attention/:path*"] };
