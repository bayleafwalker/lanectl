+import { notFound } from "next/navigation";
+
+import { AppShell } from "@/components/app-shell";
+import { AttentionRecordView } from "@/components/attention-record-view";
+import { getAttentionRecord, getCurrentUser } from "@/lib/backend";
+import { parseAttentionRoute } from "@/lib/attention";
+
+export default async function AttentionRecordPage({ params }) {
+  const route = parseAttentionRoute(params?.kind, params?.key);
+  if (!route) notFound();
+  const user = await getCurrentUser();
+  const record = await getAttentionRecord(route.kind, route.itemId);
+  return (
+    <AppShell
+      currentPath="/operating-picture"
+      user={user}
+      title="Current attention record"
+      eyebrow="Current report"
+      lede="One record from the current attention report and the source facts published for it."
+      prefetch={false}
+    >
+      <AttentionRecordView
+        kind={route.kind}
+        state={record.status}
+        rows={record.status === "ok" ? record.rows : []}
+      />
+    </AppShell>
+  );
+}
