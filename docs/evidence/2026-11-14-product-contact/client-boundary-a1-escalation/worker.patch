+++ b/apps/web/frontend/lib/attention-key.ts
@@ -0,0 +1,122 @@
+const BASE64URL_ALPHABET =
+  "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+
+const BASE64URL_VALUES = new Map<string, number>(
+  Array.from(BASE64URL_ALPHABET, (character, index) => [character, index])
+);
+
+export const ATTENTION_RECORD_KINDS = [
+  "anomaly",
+  "upcoming_cost",
+  "contract_review",
+  "contract_renewal"
+] as const;
+
+export type AttentionRecordKind = (typeof ATTENTION_RECORD_KINDS)[number];
+
+export function isAttentionRecordKind(
+  value: unknown
+): value is AttentionRecordKind {
+  return (ATTENTION_RECORD_KINDS as readonly unknown[]).includes(value);
+}
+
+function hasUnpairedSurrogate(value: string): boolean {
+  for (let index = 0; index < value.length; index += 1) {
+    const code = value.charCodeAt(index);
+    if (code >= 0xd800 && code <= 0xdbff) {
+      const next = value.charCodeAt(index + 1);
+      if (!(next >= 0xdc00 && next <= 0xdfff)) {
+        return true;
+      }
+      index += 1;
+    } else if (code >= 0xdc00 && code <= 0xdfff) {
+      return true;
+    }
+  }
+  return false;
+}
+
+function encodeBase64Url(bytes: Uint8Array): string {
+  let output = "";
+  for (let index = 0; index < bytes.length; index += 3) {
+    const first = bytes[index] ?? 0;
+    const second = bytes[index + 1] ?? 0;
+    const third = bytes[index + 2] ?? 0;
+    const chunk = (first << 16) | (second << 8) | third;
+    output += BASE64URL_ALPHABET[(chunk >> 18) & 63];
+    output += BASE64URL_ALPHABET[(chunk >> 12) & 63];
+    if (index + 1 < bytes.length) {
+      output += BASE64URL_ALPHABET[(chunk >> 6) & 63];
+    }
+    if (index + 2 < bytes.length) {
+      output += BASE64URL_ALPHABET[chunk & 63];
+    }
+  }
+  return output;
+}
+
+function decodeBase64Url(value: string): Uint8Array | null {
+  if (!/^[A-Za-z0-9_-]+$/.test(value)) {
+    return null;
+  }
+  const remainder = value.length % 4;
+  if (remainder === 1) {
+    return null;
+  }
+  const tail = BASE64URL_VALUES.get(value[value.length - 1] as string);
+  if (tail === undefined) {
+    return null;
+  }
+  if (remainder === 2 && (tail & 0x0f) !== 0) {
+    return null;
+  }
+  if (remainder === 3 && (tail & 0x03) !== 0) {
+    return null;
+  }
+  const output = new Uint8Array(Math.floor((value.length * 3) / 4));
+  let buffer = 0;
+  let bits = 0;
+  let offset = 0;
+  for (const character of value) {
+    const sextet = BASE64URL_VALUES.get(character);
+    if (sextet === undefined) {
+      return null;
+    }
+    buffer = (buffer << 6) | sextet;
+    bits += 6;
+    if (bits >= 8) {
+      bits -= 8;
+      output[offset] = (buffer >> bits) & 0xff;
+      offset += 1;
+    }
+  }
+  return output.subarray(0, offset);
+}
+
+export function encodeAttentionKey(itemId: string): string {
+  if (typeof itemId !== "string" || itemId.length === 0) {
+    throw new TypeError("Attention key must be a nonempty string.");
+  }
+  if (hasUnpairedSurrogate(itemId)) {
+    throw new TypeError("Attention key must be well-formed Unicode.");
+  }
+  return encodeBase64Url(new TextEncoder().encode(itemId));
+}
+
+export function decodeAttentionKey(key: unknown): string | null {
+  if (typeof key !== "string" || key.length === 0) {
+    return null;
+  }
+  const bytes = decodeBase64Url(key);
+  if (bytes === null || bytes.length === 0) {
+    return null;
+  }
+  try {
+    return new TextDecoder("utf-8", {
+      fatal: true,
+      ignoreBOM: true
+    }).decode(bytes);
+  } catch {
+    return null;
+  }
+}
