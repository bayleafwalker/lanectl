@@ -0,0 +1,204 @@
+import type { components } from "../generated/api";
+
+import {
+  decodeAttentionKey,
+  isAttentionRecordKind,
+  type AttentionRecordKind
+} from "./attention-key";
+import { backendRequest } from "./backend";
+import { redirect } from "next/navigation";
+
+export type AttentionPublicRows = {
+  anomaly: components["schemas"]["TransactionAnomaliesRow"];
+  upcoming_cost: components["schemas"]["UpcomingFixedCostsRow"];
+  contract_review: components["schemas"]["ContractReviewCandidatesRow"];
+  contract_renewal: components["schemas"]["ContractRenewalWatchlistRow"];
+};
+
+export type AttentionSafeRow<T> = { [P in keyof T]?: T[P] | null };
+
+export type AttentionRecordResult<
+  K extends AttentionRecordKind = AttentionRecordKind
+> =
+  | {
+      [P in K]: {
+        status: "ok";
+        kind: P;
+        item_id: string;
+        rows: AttentionSafeRow<AttentionPublicRows[P]>[];
+      };
+    }[K]
+  | { status: "invalid" | "denied" | "not_found" }
+  | { status: "unavailable"; retryAfter: string | null };
+
+type ScalarType = "string" | "number";
+
+const ROW_FIELDS: {
+  [K in AttentionRecordKind]: {
+    readonly [P in keyof AttentionPublicRows[K]]: ScalarType;
+  };
+} = {
+  anomaly: {
+    amount: "string", anomaly_reason: "string", anomaly_type: "string",
+    booking_date: "string", counterparty_name: "string", direction: "string",
+    transaction_id: "string"
+  },
+  upcoming_cost: {
+    charge_id: "string", confidence: "string", contract_name: "string",
+    currency: "string", expected_amount: "string", expected_date: "string",
+    frequency: "string", provider: "string"
+  },
+  contract_review: {
+    contract_id: "string", currency: "string", current_price: "string",
+    market_reference: "string", provider: "string", reason: "string",
+    score: "number", utility_type: "string"
+  },
+  contract_renewal: {
+    contract_duration_days: "number", contract_id: "string",
+    contract_name: "string", currency: "string", current_price: "string",
+    days_until_renewal: "number", provider: "string", renewal_date: "string",
+    utility_type: "string"
+  }
+};
+
+const PROTOCOL_ERROR = "Attention record response failed validation.";
+
+function protocolError(): Error {
+  return new Error(PROTOCOL_ERROR);
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function isSafeRow(kind: AttentionRecordKind, value: unknown): boolean {
+  if (!isRecord(value)) {
+    return false;
+  }
+  const fields = ROW_FIELDS[kind] as Record<string, ScalarType>;
+  for (const [name, fieldValue] of Object.entries(value)) {
+    const expected = fields[name];
+    if (expected === undefined) {
+      return false;
+    }
+    if (fieldValue === null) {
+      continue;
+    }
+    if (typeof fieldValue !== expected) {
+      return false;
+    }
+  }
+  return true;
+}
+
+function parseRows<K extends AttentionRecordKind>(
+  kind: K,
+  itemId: string,
+  payload: unknown
+): AttentionSafeRow<AttentionPublicRows[K]>[] {
+  if (!isRecord(payload)) {
+    throw protocolError();
+  }
+  const keys = Object.keys(payload);
+  if (
+    keys.length !== 2 ||
+    !keys.includes("item_id") ||
+    !keys.includes("rows")
+  ) {
+    throw protocolError();
+  }
+  if (payload.item_id !== itemId) {
+    throw protocolError();
+  }
+  const rows = payload.rows;
+  if (!Array.isArray(rows) || !rows.every((row) => isSafeRow(kind, row))) {
+    throw protocolError();
+  }
+  return rows as AttentionSafeRow<AttentionPublicRows[K]>[];
+}
+
+const WEEKDAY = "(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)";
+const LONG_WEEKDAY = "(?:Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)";
+const MONTH = "(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)";
+const IMF_FIXDATE = new RegExp(`^${WEEKDAY}, \\d{2} ${MONTH} \\d{4} \\d{2}:\\d{2}:\\d{2} GMT$`);
+const RFC_850_DATE = new RegExp(`^${LONG_WEEKDAY}, \\d{2}-${MONTH}-\\d{2} \\d{2}:\\d{2}:\\d{2} GMT$`);
+const ASCTIME_DATE = new RegExp(`^${WEEKDAY} ${MONTH} [ \\d]\\d \\d{2}:\\d{2}:\\d{2} \\d{4}$`);
+
+function parseRetryAfter(value: string | null): string | null {
+  if (value === null) {
+    return null;
+  }
+  const candidate = value.trim();
+  if (/^\d+$/.test(candidate)) {
+    return candidate;
+  }
+  const httpDate = IMF_FIXDATE.test(candidate) || RFC_850_DATE.test(candidate) || ASCTIME_DATE.test(candidate);
+  return httpDate && !Number.isNaN(Date.parse(candidate)) ? candidate : null;
+}
+
+function requestRecord(kind: AttentionRecordKind, itemId: string): Promise<Response> {
+  const params = { params: { path: { item_id: itemId } } };
+  switch (kind) {
+    case "anomaly":
+      return backendRequest("get", "/reports/transaction-anomalies/records/{item_id}", params);
+    case "upcoming_cost":
+      return backendRequest("get", "/reports/upcoming-fixed-costs/records/{item_id}", params);
+    case "contract_review":
+      return backendRequest("get", "/reports/contract-review-candidates/records/{item_id}", params);
+    case "contract_renewal":
+      return backendRequest("get", "/reports/contract-renewal-watchlist/records/{item_id}", params);
+  }
+}
+
+export function getAttentionRecord<K extends AttentionRecordKind>(
+  kind: K,
+  routeKey: string
+): Promise<AttentionRecordResult<K>>;
+export function getAttentionRecord(
+  kind: unknown,
+  routeKey: unknown
+): Promise<AttentionRecordResult>;
+export async function getAttentionRecord(
+  kind: unknown,
+  routeKey: unknown
+): Promise<AttentionRecordResult> {
+  if (!isAttentionRecordKind(kind)) {
+    return { status: "invalid" };
+  }
+  const itemId = decodeAttentionKey(routeKey);
+  if (itemId === null) {
+    return { status: "invalid" };
+  }
+
+  let response: Response;
+  try {
+    response = await requestRecord(kind, itemId);
+  } catch {
+    throw protocolError();
+  }
+
+  if (response.status === 401) {
+    redirect("/login");
+  }
+  if (response.status === 403) return { status: "denied" };
+  if (response.status === 404) return { status: "not_found" };
+  if (response.status === 503) {
+    return {
+      status: "unavailable",
+      retryAfter: parseRetryAfter(response.headers.get("retry-after"))
+    };
+  }
+  if (!response.ok) {
+    throw protocolError();
+  }
+
+  let payload: unknown;
+  try {
+    payload = await response.json();
+  } catch {
+    throw protocolError();
+  }
+
+  const rows = parseRows(kind, itemId, payload);
+  return { status: "ok", kind, item_id: itemId, rows } as AttentionRecordResult;
+}
