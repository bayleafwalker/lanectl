+"""Frozen contracts and codec regressions for the attention record boundary."""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+FRONTEND = ROOT / "apps" / "web" / "frontend"
+CONTRACTS = FRONTEND / "ui-contracts" / "attention-current-report"
+
+FROZEN = {
+    "intent.md": (9, "fb195a7c65517da1c0b4781759f1f89fb636f759e90b7befca55f788e9cb1f85"),
+    "baseline.tokens.json": (
+        43,
+        "ce1a7d8a48cf483519994f5d37872b49fe8472950bc6ef89a4451970c4f9c862",
+    ),
+    "ui-contract.yaml": (32, "603153cffbf78388d003a30387d4a2db63a3e4289da0e18a96fa934bc6392ee1"),
+}
+
+
+def test_frozen_attention_style_triplet_is_copied_unchanged() -> None:
+    for name, (lines, digest) in FROZEN.items():
+        path = CONTRACTS / name
+        assert path.is_file(), f"missing frozen contract {name}"
+        content = path.read_bytes()
+        assert content.count(b"\n") == lines
+        assert hashlib.sha256(content).hexdigest() == digest
+
+
+def test_attention_key_codec_is_strict_and_dependency_free(tmp_path: Path) -> None:
+    source = FRONTEND / "lib" / "attention-key.ts"
+    assert source.is_file()
+    text = source.read_text()
+    assert not any(token in text for token in ("Buffer", "require(", 'from "', "from '"))
+
+    node = shutil.which("node")
+    assert node is not None, "Node 20 is required for the codec regression"
+    tsc = FRONTEND / "node_modules" / ".bin" / "tsc"
+    if not tsc.is_file():
+        tsc = Path(shutil.which("tsc") or "")
+    assert tsc.is_file(), "frontend node_modules must be installed (npm ci)"
+
+    compiled = tmp_path / "out"
+    (tmp_path / "node_modules").symlink_to(FRONTEND / "node_modules", target_is_directory=True)
+    build = subprocess.run(
+        [
+            str(tsc),
+            str(source),
+            "--target",
+            "ES2022",
+            "--module",
+            "commonjs",
+            "--moduleResolution",
+            "node",
+            "--lib",
+            "ES2022,DOM",
+            "--types",
+            "node",
+            "--skipLibCheck",
+            "--outDir",
+            str(compiled),
+        ],
+        cwd=tmp_path,
+        capture_output=True,
+        text=True,
+        timeout=90,
+    )
+    assert build.returncode == 0, build.stdout + build.stderr
+    module = compiled / "attention-key.js"
+    assert module.is_file()
+
+    values = [
+        "anomaly_a/b_%_雪",
+        "review_grid/north_ä",
+        "renewal_🙂/x",
+        "\ufeffbom-leading",
+        "nul\u0000inside",
+        "a" * 511,
+    ]
+    invalid = ["", "YQ==", "YR", "a", "bad+", "_w", "wK8", "7aCA", None, 4, []]
+    runner = (
+        "const m=require(process.argv[1]); const v=JSON.parse(process.argv[2]);"
+        "const out={encoded:v.values.map(x=>m.encodeAttentionKey(x)),"
+        "decoded:v.values.map(x=>m.decodeAttentionKey(m.encodeAttentionKey(x))),"
+        "invalid:v.invalid.map(x=>m.decodeAttentionKey(x)),"
+        "kinds:v.kinds.map(x=>m.isAttentionRecordKind(x)),reject:[]};"
+        "for(const x of v.reject){try{m.encodeAttentionKey(x);out.reject.push(false)}"
+        "catch(e){out.reject.push(e instanceof TypeError)}}"
+        "console.log(JSON.stringify(out));"
+    )
+    payload = {
+        "values": values,
+        "invalid": invalid,
+        "kinds": [
+            "anomaly",
+            "upcoming_cost",
+            "contract_review",
+            "contract_renewal",
+            "other",
+            None,
+            1,
+        ],
+        "reject": ["", 42, None, {}, [], "\ud800", "\udc00", "\ud800x", "x\udc00"],
+    }
+    run = subprocess.run(
+        [node, "-e", runner, str(module), json.dumps(payload)],
+        cwd=tmp_path,
+        capture_output=True,
+        text=True,
+        timeout=30,
+    )
+    assert run.returncode == 0, run.stderr
+    result = json.loads(run.stdout)
+    expected = [
+        base64.urlsafe_b64encode(value.encode("utf-8")).decode().rstrip("=") for value in values
+    ]
+    assert result["decoded"] == values
+    assert result["encoded"] == expected
+    assert result["encoded"][3].startswith("77u_")
+    assert result["invalid"] == [None] * len(invalid)
+    assert result["kinds"] == [True] * 4 + [False] * 3
+    assert result["reject"] == [True] * len(payload["reject"])
+
+
+def test_attention_record_module_keeps_transport_local() -> None:
+    source = (FRONTEND / "lib" / "attention-record.ts").read_text()
+    for required in (
+        'from "./backend"',
+        'from "./attention-key"',
+        'from "next/navigation"',
+        "backendRequest",
+        'redirect("/login")',
+    ):
+        assert required in source
+    for forbidden in ("backendGet", "reports/attention-items", "resp.json()"):
+        assert forbidden not in source
+    assert source.count("records/{item_id}") == 4
