diff --git a/apps/web/frontend/lib/onboarding-checklist-state.mjs b/apps/web/frontend/lib/onboarding-checklist-state.mjs
new file mode 100644
index 0000000..9153620
--- /dev/null
+++ b/apps/web/frontend/lib/onboarding-checklist-state.mjs
@@ -0,0 +1,69 @@
+/**
+ * Pure, framework-free state rules for the dashboard onboarding checklist.
+ *
+ * The freshness window, progress aggregation and compact/badge/full view
+ * decision are shared by the dashboard page and the OnboardingChecklist
+ * component through this one unit-testable boundary. Source definitions are
+ * passed in explicitly (never imported from the ESM onboarding-sources
+ * module) so these helpers stay dependency-free and testable in isolation.
+ */
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const FRESH_DAYS = 7;
+
+/**
+ * Names of datasets whose latest landed_at is strictly less than seven days
+ * old. Future timestamps count as fresh; invalid, null and empty timestamps
+ * do not. Duplicate dataset names are preserved, matching the legacy page
+ * calculation.
+ *
+ * @param {{ dataset_name: string, landed_at: string | number | null }[]} rows
+ * @param {number} [nowMs]
+ * @returns {string[]}
+ */
+export function freshDatasetNames(rows, nowMs) {
+  const now = nowMs == null ? Date.now() : nowMs;
+  return rows
+    .filter((row) => {
+      if (!row.landed_at) return false;
+      const diffDays = (now - new Date(row.landed_at)) / DAY_MS;
+      return diffDays < FRESH_DAYS;
+    })
+    .map((row) => row.dataset_name);
+}
+
+/**
+ * Aggregate checklist progress from source definitions and fresh dataset
+ * names.
+ *
+ * @param {{ dataset: string, required?: boolean }[]} sources
+ * @param {string[]} freshDatasets
+ * @returns {{ activeCount: number, requiredDone: number, requiredTotal: number, allCoreActive: boolean }}
+ */
+export function checklistProgress(sources, freshDatasets) {
+  const steps = sources.map((source) => ({
+    ...source,
+    active: freshDatasets.includes(source.dataset),
+  }));
+  const activeCount = steps.filter((step) => step.active).length;
+  const requiredDone = steps.filter((step) => step.required && step.active).length;
+  const requiredTotal = steps.filter((step) => step.required).length;
+  const allCoreActive = requiredDone >= requiredTotal;
+  return { activeCount, requiredDone, requiredTotal, allCoreActive };
+}
+
+/**
+ * Decide which view to render: "hidden" (dismissed), "badge" (manually
+ * compacted or all core active) or "full". An explicit in-memory expansion
+ * (userExpanded) overrides the automatic compact badge; dismissal always
+ * wins.
+ *
+ * @param {{ dismissed: boolean, compact: boolean, userExpanded: boolean, allCoreActive: boolean }} state
+ * @returns {"hidden" | "badge" | "full"}
+ */
+export function checklistView({ dismissed, compact, userExpanded, allCoreActive }) {
+  if (dismissed) return "hidden";
+  if (userExpanded) return "full";
+  if (compact || allCoreActive) return "badge";
+  return "full";
+}
diff --git a/apps/web/frontend/unit/onboarding-checklist-state.test.mjs b/apps/web/frontend/unit/onboarding-checklist-state.test.mjs
new file mode 100644
index 0000000..75a8697
--- /dev/null
+++ b/apps/web/frontend/unit/onboarding-checklist-state.test.mjs
@@ -0,0 +1,107 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+const { freshDatasetNames, checklistProgress, checklistView } = await import(
+  new URL("../lib/onboarding-checklist-state.mjs", import.meta.url)
+);
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+// A fixed reference instant: 14 Nov 2026 12:00 UTC.
+const NOW = Date.UTC(2026, 10, 14, 12);
+const iso = (ms) => new Date(ms).toISOString();
+
+const SOURCES = [
+  { dataset: "account_transactions", required: true },
+  { dataset: "subscriptions", required: true },
+  { dataset: "contract_prices" },
+  { dataset: "budgets" },
+  { dataset: "loan_repayments" },
+];
+
+test("freshness strict 7-day boundary: equality and one millisecond either side", () => {
+  const rows = [
+    { dataset_name: "just_inside", landed_at: iso(NOW - 7 * DAY_MS + 1) },
+    { dataset_name: "equal", landed_at: iso(NOW - 7 * DAY_MS) },
+    { dataset_name: "just_outside", landed_at: iso(NOW - 7 * DAY_MS - 1) },
+  ];
+  assert.deepEqual(freshDatasetNames(rows, NOW), ["just_inside"]);
+});
+
+test("freshness future timestamp is fresh", () => {
+  const rows = [{ dataset_name: "future", landed_at: iso(NOW + DAY_MS) }];
+  assert.deepEqual(freshDatasetNames(rows, NOW), ["future"]);
+});
+
+test("freshness invalid, null and empty timestamps are not fresh", () => {
+  const rows = [
+    { dataset_name: "invalid", landed_at: "not-a-date" },
+    { dataset_name: "null", landed_at: null },
+    { dataset_name: "empty", landed_at: "" },
+  ];
+  assert.deepEqual(freshDatasetNames(rows, NOW), []);
+});
+
+test("freshness absent landed_at is not fresh", () => {
+  const rows = [{ dataset_name: "missing" }];
+  assert.deepEqual(freshDatasetNames(rows, NOW), []);
+});
+
+test("progress counts required versus optional and ignores duplicate names", () => {
+  const p = checklistProgress(SOURCES, [
+    "account_transactions",
+    "account_transactions",
+    "contract_prices",
+    "budgets",
+    "loan_repayments",
+    "unknown",
+  ]);
+  assert.equal(p.activeCount, 4);
+  assert.equal(p.requiredDone, 1);
+  assert.equal(p.requiredTotal, 2);
+  assert.equal(p.allCoreActive, false);
+});
+
+test("progress with an empty fresh list yields zero active counts", () => {
+  const p = checklistProgress(SOURCES, []);
+  assert.equal(p.activeCount, 0);
+  assert.equal(p.requiredDone, 0);
+  assert.equal(p.requiredTotal, 2);
+  assert.equal(p.allCoreActive, false);
+});
+
+test("passive auto-collapse: all core active shows badge", () => {
+  const p = checklistProgress(SOURCES, ["account_transactions", "subscriptions"]);
+  assert.equal(p.allCoreActive, true);
+  assert.equal(
+    checklistView({ dismissed: false, compact: false, userExpanded: false, allCoreActive: p.allCoreActive }),
+    "badge",
+  );
+});
+
+test("manual compact without core shows badge", () => {
+  assert.equal(
+    checklistView({ dismissed: false, compact: true, userExpanded: false, allCoreActive: false }),
+    "badge",
+  );
+});
+
+test("session expansion overrides auto-compact", () => {
+  assert.equal(
+    checklistView({ dismissed: false, compact: false, userExpanded: true, allCoreActive: true }),
+    "full",
+  );
+});
+
+test("dismissal wins over compact and expansion", () => {
+  assert.equal(
+    checklistView({ dismissed: true, compact: true, userExpanded: true, allCoreActive: true }),
+    "hidden",
+  );
+});
+
+test("no core, not compact, not expanded shows full", () => {
+  assert.equal(
+    checklistView({ dismissed: false, compact: false, userExpanded: false, allCoreActive: false }),
+    "full",
+  );
+});
diff --git a/tests/test_onboarding_checklist_unit.py b/tests/test_onboarding_checklist_unit.py
new file mode 100644
index 0000000..e26e00d
--- /dev/null
+++ b/tests/test_onboarding_checklist_unit.py
@@ -0,0 +1,43 @@
+"""Pytest wrapper that executes the built-in Node unit tests for the shared
+onboarding-checklist-state helper.
+
+Runs Node 20 against
+``apps/web/frontend/unit/onboarding-checklist-state.test.mjs`` so the normal
+Python test suite exercises the actual unit tests. Fails (rather than skips)
+when Node is unavailable or when any unit assertion fails.
+"""
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+UNIT_TEST = ROOT / "apps/web/frontend/unit/onboarding-checklist-state.test.mjs"
+
+
+def _find_node():
+    candidates = [
+        os.environ.get("HLA_NODE"),
+        shutil.which("node"),
+        *[str(p) for p in sorted((ROOT / ".tooling").glob("node-v20*/bin/node"))],
+        "/projects/dev/homelab-analytics/.tooling/node-v20.20.1-linux-x64/bin/node",
+    ]
+    for candidate in candidates:
+        if candidate and Path(candidate).is_file():
+            return candidate
+    return None
+
+
+def test_onboarding_checklist_state_unit():
+    node = _find_node()
+    assert node, "Node 20 is required but unavailable"
+    result = subprocess.run(
+        [node, str(UNIT_TEST)],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+    )
+    output = result.stdout + result.stderr
+    assert result.returncode == 0, (
+        f"onboarding-checklist-state unit tests failed (exit {result.returncode}):\n{output}"
+    )
