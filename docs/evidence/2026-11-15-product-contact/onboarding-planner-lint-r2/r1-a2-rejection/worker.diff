diff --git a/apps/web/frontend/lib/onboarding-checklist-state.mjs b/apps/web/frontend/lib/onboarding-checklist-state.mjs
new file mode 100644
index 0000000..b553f88
--- /dev/null
+++ b/apps/web/frontend/lib/onboarding-checklist-state.mjs
@@ -0,0 +1,65 @@
+/**
+ * Shared onboarding checklist rules.
+ *
+ * Pure functions so the dashboard page, the checklist component, and Node unit
+ * tests use one definition of freshness, progress, and visible view. Source
+ * definitions are passed in explicitly; this module deliberately imports no
+ * app source so it stays usable outside the Next runtime.
+ */
+
+const FRESH_WINDOW_MS = 7 * 24 * 60 * 60 * 1000;
+
+/**
+ * Names of datasets whose latest landing is strictly inside the 7-day window.
+ * Missing, null, empty, and unparseable timestamps are not fresh; future
+ * timestamps are fresh because the elapsed time is negative.
+ *
+ * @param {{dataset_name: string, landed_at?: string|null}[]} rows
+ * @param {number} nowMs
+ * @returns {string[]}
+ */
+export function freshDatasetNames(rows, nowMs) {
+  return rows
+    .filter((row) => {
+      if (!row.landed_at) return false;
+      return nowMs - new Date(row.landed_at).getTime() < FRESH_WINDOW_MS;
+    })
+    .map((row) => row.dataset_name);
+}
+
+/**
+ * Progress for an explicit source definition list. Fresh names that do not
+ * match a source (and repeated names) do not inflate counts.
+ *
+ * @param {{dataset: string, required?: boolean}[]} sources
+ * @param {string[]} freshDatasets
+ */
+export function checklistProgress(sources, freshDatasets) {
+  const active = new Set(freshDatasets);
+  const steps = sources.map((source) => ({ ...source, active: active.has(source.dataset) }));
+  const activeCount = steps.filter((step) => step.active).length;
+  const requiredDone = steps.filter((step) => step.required && step.active).length;
+  const requiredTotal = steps.filter((step) => step.required).length;
+  return {
+    steps,
+    activeCount,
+    requiredDone,
+    requiredTotal,
+    allCoreActive: requiredDone >= requiredTotal,
+  };
+}
+
+/**
+ * Dismissal persists over every other state; a session expansion overrides
+ * automatic and manual compaction; otherwise compaction (manual or automatic
+ * from complete core sources) shows the badge.
+ *
+ * @param {{dismissed: boolean, compact: boolean, userExpanded: boolean, allCoreActive: boolean}} state
+ * @returns {"hidden"|"badge"|"full"}
+ */
+export function checklistView({ dismissed, compact, userExpanded, allCoreActive }) {
+  if (dismissed) return "hidden";
+  if (userExpanded) return "full";
+  if (compact || allCoreActive) return "badge";
+  return "full";
+}
diff --git a/apps/web/frontend/unit/onboarding-checklist-state.test.mjs b/apps/web/frontend/unit/onboarding-checklist-state.test.mjs
new file mode 100644
index 0000000..93dffc0
