@@ -0,0 +1,113 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import {
+  checklistProgress,
+  checklistView,
+  freshDatasetNames,
+} from "../lib/onboarding-checklist-state.mjs";
+
+const NOW = Date.UTC(2026, 10, 14, 12);
+const DAY = 24 * 60 * 60 * 1000;
+
+const SOURCES = [
+  { dataset: "account_transactions", required: true },
+  { dataset: "subscriptions", required: true },
+  { dataset: "contract_prices", required: false },
+  { dataset: "budgets", required: false },
+  { dataset: "loan_repayments", required: false },
+];
+
+test("freshness keeps a strict seven day boundary", () => {
+  const rows = [
+    { dataset_name: "inside", landed_at: new Date(NOW - 7 * DAY + 1).toISOString() },
+    { dataset_name: "equal", landed_at: new Date(NOW - 7 * DAY).toISOString() },
+    { dataset_name: "outside", landed_at: new Date(NOW - 7 * DAY - 1).toISOString() },
+  ];
+  assert.deepEqual(freshDatasetNames(rows, NOW), ["inside"]);
+});
+
+test("freshness treats future timestamps as fresh and unusable timestamps as stale", () => {
+  const rows = [
+    { dataset_name: "future", landed_at: new Date(NOW + DAY).toISOString() },
+    { dataset_name: "invalid", landed_at: "not a timestamp" },
+    { dataset_name: "null", landed_at: null },
+    { dataset_name: "empty", landed_at: "" },
+    { dataset_name: "absent" },
+  ];
+  assert.deepEqual(freshDatasetNames(rows, NOW), ["future"]);
+});
+
+test("progress separates required sources from optional sources", () => {
+  const progress = checklistProgress(SOURCES, ["account_transactions", "contract_prices"]);
+  assert.equal(progress.activeCount, 2);
+  assert.equal(progress.requiredDone, 1);
+  assert.equal(progress.requiredTotal, 2);
+  assert.equal(progress.allCoreActive, false);
+  assert.deepEqual(
+    progress.steps.map((step) => [step.dataset, step.active]),
+    [
+      ["account_transactions", true],
+      ["subscriptions", false],
+      ["contract_prices", true],
+      ["budgets", false],
+      ["loan_repayments", false],
+    ]
+  );
+});
+
+test("progress ignores duplicate and unknown fresh names", () => {
+  const progress = checklistProgress(SOURCES, [
+    "account_transactions",
+    "account_transactions",
+    "not_a_source",
+  ]);
+  assert.equal(progress.activeCount, 1);
+  assert.equal(progress.requiredDone, 1);
+  assert.equal(progress.requiredTotal, 2);
+  assert.equal(progress.allCoreActive, false);
+});
+
+test("progress reports complete core sources and the empty source list", () => {
+  const complete = checklistProgress(SOURCES, ["account_transactions", "subscriptions"]);
+  assert.equal(complete.allCoreActive, true);
+  assert.equal(complete.activeCount, 2);
+  const empty = checklistProgress([], []);
+  assert.equal(empty.activeCount, 0);
+  assert.equal(empty.requiredDone, 0);
+  assert.equal(empty.requiredTotal, 0);
+  assert.equal(empty.allCoreActive, true);
+});
+
+test("view keeps dismissal above every other state", () => {
+  assert.equal(
+    checklistView({ dismissed: true, compact: true, userExpanded: true, allCoreActive: true }),
+    "hidden"
+  );
+});
+
+test("view keeps the session expansion above compaction", () => {
+  assert.equal(
+    checklistView({ dismissed: false, compact: false, userExpanded: true, allCoreActive: true }),
+    "full"
+  );
+  assert.equal(
+    checklistView({ dismissed: false, compact: true, userExpanded: true, allCoreActive: false }),
+    "full"
+  );
+});
+
+test("view auto-compacts passively and honours manual compaction", () => {
+  assert.equal(
+    checklistView({ dismissed: false, compact: false, userExpanded: false, allCoreActive: true }),
+    "badge"
+  );
+  assert.equal(
+    checklistView({ dismissed: false, compact: true, userExpanded: false, allCoreActive: false }),
+    "badge"
+  );
+  assert.equal(
+    checklistView({ dismissed: false, compact: false, userExpanded: false, allCoreActive: false }),
+    "full"
+  );
+});
diff --git a/tests/test_onboarding_checklist_unit.py b/tests/test_onboarding_checklist_unit.py
