@@ -0,0 +1,73 @@
+"""Run the onboarding checklist state unit tests under Node 20.
+
+The dashboard rules live in a browser/Node ESM module, so the focused checks are
+Node built-in tests. This wrapper makes the normal Python suite execute them and
+fails (never skips) when a Node 20 runtime is unavailable.
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+HELPER = Path("apps/web/frontend/lib/onboarding-checklist-state.mjs")
+UNIT_TEST = Path("apps/web/frontend/unit/onboarding-checklist-state.test.mjs")
+PINNED_FALLBACK = "/projects/dev/homelab-analytics/.tooling/node-v20.20.1-linux-x64/bin/node"
+
+
+def _repo_root() -> Path:
+    """Locate the checkout under test.
+
+    The working directory wins when it holds the helper: candidate-copy gates
+    run this wrapper from an owned copy (and may pass an absolute wrapper path),
+    and the mutated helper in that copy must be the one exercised.
+    """
+    here = Path(__file__).resolve()
+    for candidate in (Path.cwd(), *here.parents):
+        if (candidate / HELPER).is_file():
+            return candidate
+    return here.parents[1]
+
+
+def _node_binary(root: Path) -> str:
+    override = os.environ.get("HLA_NODE")
+    if override:
+        probe = subprocess.run([override, "--version"], capture_output=True, text=True)
+        if probe.returncode != 0 or not probe.stdout.startswith("v20."):
+            raise AssertionError(
+                f"Node 20 unavailable through HLA_NODE={override}: "
+                f"exit={probe.returncode} stdout={probe.stdout!r} stderr={probe.stderr!r}"
+            )
+        return override
+    candidates = [
+        shutil.which("node"),
+        *[str(path) for path in sorted((root / ".tooling").glob("node-v20*/bin/node"))],
+        PINNED_FALLBACK,
+    ]
+    for candidate in candidates:
+        if not candidate or not Path(candidate).is_file():
+            continue
+        probe = subprocess.run([candidate, "--version"], capture_output=True, text=True)
+        if probe.returncode == 0 and probe.stdout.startswith("v20."):
+            return candidate
+    raise AssertionError("Node 20 is required to run the onboarding checklist unit tests")
+
+
+def test_onboarding_checklist_state_unit() -> None:
+    root = _repo_root()
+    unit_test = root / UNIT_TEST
+    if not unit_test.is_file():
+        raise AssertionError(f"missing Node unit test: {unit_test}")
+    node = _node_binary(root)
+    result = subprocess.run(
+        [node, str(unit_test)],
+        cwd=root,
+        capture_output=True,
+        text=True,
+        timeout=120,
+    )
+    output = result.stdout + result.stderr
+    if result.returncode != 0:
+        raise AssertionError(f"Node unit tests failed (exit {result.returncode}):\n{output}")
