@@ -0,0 +1,41 @@
+"""Run the frontend unit tests for the source-row upload BFF helpers.
+
+These helpers are the pure, security-sensitive mapping functions behind the
+`POST /sources/{source_asset_id}/dry-run` and `/upload` BFF routes. They are
+written in JavaScript and exercised here through Node's built-in test runner so
+their semantics (not just their presence) are covered.
+"""
+
+from __future__ import annotations
+
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+FRONTEND_ROOT = ROOT / "apps" / "web" / "frontend"
+UNIT_TESTS = FRONTEND_ROOT / "unit" / "source-row-upload-model.test.mjs"
+
+
+def _node_binary() -> str:
+    pinned = Path("/projects/dev/homelab-analytics/.tooling/node-v20.20.1-linux-x64/bin/node")
+    if pinned.is_file():
+        return str(pinned)
+    discovered = shutil.which("node")
+    assert discovered, "node is required to run the frontend unit tests"
+    return discovered
+
+
+@pytest.mark.slow
+def test_source_row_upload_model_unit_tests() -> None:
+    assert UNIT_TESTS.is_file(), "frontend unit test file missing"
+    result = subprocess.run(
+        [_node_binary(), "--test", str(UNIT_TESTS)],
+        cwd=FRONTEND_ROOT,
+        capture_output=True,
+        text=True,
+        timeout=120,
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
