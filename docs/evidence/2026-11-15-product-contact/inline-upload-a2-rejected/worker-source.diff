+++ b/apps/web/frontend/unit/source-row-upload-model.test.mjs
@@ -0,0 +1,134 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import {
+  classifyUpload,
+  normalizeDryRunPayload,
+  normalizeIssue,
+  normalizePromotion,
+  resolveAvailability,
+  sanitizeTarget,
+  trimSourceName
+} from "../lib/source-row-upload-model.mjs";
+
+test("normalizeIssue keeps only the fixed safe templates", () => {
+  assert.deepEqual(
+    normalizeIssue({ code: "unknown", message: "SECRET_VALUE https://sensitive.invalid/trace STACKTRACE", column: "SECRET_VALUE", row_number: "STACKTRACE" }),
+    { code: "unknown", message: "Validation issue." }
+  );
+  assert.deepEqual(normalizeIssue({ code: "duplicate_file", message: "anything" }), {
+    code: "duplicate_file",
+    message: "File already exists."
+  });
+  assert.deepEqual(normalizeIssue({ code: "private_code", message: "leak" }), {
+    code: "unknown",
+    message: "Validation issue."
+  });
+});
+
+test("normalizeIssue interpolates a validated column for missing_required_value", () => {
+  assert.deepEqual(
+    normalizeIssue({ code: "missing_required_value", message: "SECRET_VALUE", column: "amount", row_number: 2 }),
+    { code: "missing_required_value", message: "Required value missing for column 'amount'.", column: "amount", row_number: 2 }
+  );
+  assert.deepEqual(
+    normalizeIssue({ code: "missing_required_value", column: "https://private", row_number: "2" }),
+    { code: "unknown", message: "Validation issue." }
+  );
+});
+
+test("normalizePromotion permits only the four safe fields", () => {
+  assert.deepEqual(
+    normalizePromotion({ skipped: true, skip_reason: "secret", diagnostic: "leak", source_asset_id: "x" }),
+    { skipped: true }
+  );
+  assert.deepEqual(
+    normalizePromotion({ facts_loaded: 3, marts_refreshed: ["m", 7], publication_keys: ["k"], skipped: false }),
+    { facts_loaded: 3, marts_refreshed: ["m"], publication_keys: ["k"], skipped: false }
+  );
+  assert.equal(normalizePromotion(null), null);
+});
+
+test("sanitizeTarget and normalizeDryRunPayload drop non-whitelisted fields", () => {
+  assert.deepEqual(
+    sanitizeTarget({ source_asset_id: "a", upload_path: "/upload/configured-csv", confidence_label: "manual", contract_id: "leak", confidence_score: 1 }),
+    { source_asset_id: "a", upload_path: "/upload/configured-csv", confidence_label: "manual" }
+  );
+  const payload = normalizeDryRunPayload({
+    preview: {
+      target: { source_asset_id: "a", upload_path: "/upload/configured-csv", confidence_label: "manual", kind: "leak" },
+      ready: true,
+      row_count: 4,
+      date_range: { leak: true },
+      issues: [{ code: "unknown", message: "SECRET_VALUE", column: "SECRET_VALUE" }],
+      detection: { format: "csv", file_name: "leak.csv" }
+    }
+  });
+  assert.equal(payload.ready, true);
+  assert.equal(payload.row_count, 4);
+  assert.deepEqual(payload.target, { source_asset_id: "a", upload_path: "/upload/configured-csv", confidence_label: "manual" });
+  assert.deepEqual(payload.detection, { format: "csv" });
+  assert.deepEqual(payload.issues, [{ code: "unknown", message: "Validation issue." }]);
+});
+
+test("resolveAvailability fails closed on every unavailable path", () => {
+  const asset = { source_asset_id: "a", source_system_id: "s", column_mapping_id: "m", dataset_contract_id: "c", enabled: true };
+  const system = { source_system_id: "s", enabled: true };
+  const mapping = { column_mapping_id: "m" };
+  const contract = { dataset_contract_id: "c" };
+  assert.equal(resolveAvailability("", [asset], [system], [mapping], [contract]).available, false);
+  assert.equal(resolveAvailability("a", null, [system], [mapping], [contract]).reason, "Upload unavailable");
+  assert.equal(resolveAvailability("a", [], [system], [mapping], [contract]).reason, "Source not found");
+  assert.equal(resolveAvailability("a", [{ ...asset, enabled: false }], [system], [mapping], [contract]).reason, "Source disabled");
+  assert.equal(resolveAvailability("a", [asset], [{ source_system_id: "s", enabled: false }], [mapping], [contract]).reason, "Source system disabled");
+  assert.equal(resolveAvailability("a", [asset], [system], [], [contract]).reason, "Column mapping unavailable");
+  assert.deepEqual(resolveAvailability("a", [asset], [system], [mapping], [contract]), { available: true, reason: null });
+});
+
+test("resolveAvailability does not restrict on source type or transport", () => {
+  const asset = { source_asset_id: "a", source_system_id: "s", column_mapping_id: "m", dataset_contract_id: "c", enabled: true, asset_type: "custom-device" };
+  const system = { source_system_id: "s", enabled: true, transport: "custom-transport", source_type: "free-string" };
+  assert.equal(resolveAvailability("a", [asset], [system], [{ column_mapping_id: "m" }], [{ dataset_contract_id: "c" }]).available, true);
+});
+
+test("trimSourceName trims and rejects non-strings", () => {
+  assert.equal(trimSourceName("  named  "), "named");
+  assert.equal(trimSourceName(null), "");
+});
+
+test("classifyUpload maps the receipt-bearing decisions", () => {
+  const receipt = { runId: "run-1", runStatus: "landed", rowCount: 1, issues: [], promotion: null, context: "match", freshness: { kind: "match", freshnessState: "current" } };
+  const landed = classifyUpload({ ingestStatus: 201, ...receipt });
+  assert.equal(landed.status, 201);
+  assert.equal(landed.body.outcome, "landed");
+  assert.equal(landed.body.freshness_state, "current");
+
+  const mismatch = classifyUpload({ ingestStatus: 201, runId: "run-1", runStatus: "landed", rowCount: null, issues: [], promotion: null, context: "contradiction", freshness: null });
+  assert.equal(mismatch.body.outcome, "identity_mismatch");
+  assert.equal(mismatch.body.message, "Run recorded; source identity differs.");
+  assert.equal(mismatch.body.freshness_state, undefined);
+
+  const unconfirmed = classifyUpload({ ingestStatus: 201, runId: "run-1", runStatus: "landed", rowCount: null, issues: [], promotion: null, context: "unreadable", freshness: null });
+  assert.equal(unconfirmed.body.outcome, "landed_unconfirmed");
+
+  const superseded = classifyUpload({ ingestStatus: 201, runId: "run-1", runStatus: "landed", rowCount: 1, issues: [], promotion: null, context: "match", freshness: { kind: "superseded", freshnessState: "current", latestRunId: "other-run" } });
+  assert.equal(superseded.body.observation, "superseded");
+  assert.equal(superseded.body.observed_latest_run_id, "other-run");
+
+  const duplicate = classifyUpload({ ingestStatus: 409, runId: "run-1", runStatus: "rejected", rowCount: null, issues: [{ code: "unknown", message: "Validation issue." }], promotion: null, context: "match", freshness: null });
+  assert.equal(duplicate.body.outcome, "duplicate");
+
+  const identityUnconfirmed = classifyUpload({ ingestStatus: 400, runId: "run-1", runStatus: "rejected", rowCount: null, issues: [], promotion: null, context: "unreadable", freshness: null });
+  assert.equal(identityUnconfirmed.body.outcome, "identity_unconfirmed");
+  assert.equal(identityUnconfirmed.body.message, "Run recorded; source identity could not be confirmed.");
+});
+
+test("classifyUpload never invents an outcome without a receipt", () => {
+  assert.equal(classifyUpload({ ingestStatus: 401, runId: null, runStatus: null, rowCount: null, issues: [], promotion: null, context: null, freshness: null }).body.outcome, "auth_required");
+  assert.equal(classifyUpload({ ingestStatus: 403, runId: null, runStatus: null, rowCount: null, issues: [], promotion: null, context: null, freshness: null }).body.outcome, "forbidden");
+  const unknown = classifyUpload({ ingestStatus: 422, runId: null, runStatus: null, rowCount: null, issues: [], promotion: null, context: null, freshness: null });
+  assert.equal(unknown.status, 422);
+  assert.equal(unknown.body.outcome, "outcome_unknown");
+  assert.equal(unknown.body.message, "Upload outcome could not be confirmed.");
+  assert.equal(classifyUpload({ ingestStatus: 200, runId: null, runStatus: null, rowCount: null, issues: [], promotion: null, context: null, freshness: null }).status, 502);
+});
