+"""Contract tests for the /sources pinned-target upload wiring."""
+
+from pathlib import Path
+
+FRONTEND = Path(__file__).resolve().parents[1] / "apps/web/frontend"
+
+
+def _read(path: str) -> str:
+    return (FRONTEND / path).read_text()
+
+
+def test_routes_and_handlers_keep_the_path_identity() -> None:
+    for route, handler in (
+        ("app/sources/[sourceAssetId]/dry-run/route.js", "dryRunSourceRow"),
+        ("app/sources/[sourceAssetId]/upload/route.js", "uploadSourceRow"),
+    ):
+        source = _read(route)
+        assert "sourceAssetIdFromRequest(request, params)" in source
+        assert handler in source
+    server = _read("lib/source-row-upload-route.js")
+    # Each handler builds its own multipart body: only the pinned id and the
+    # bound upload path or trimmed source name are forwarded.
+    assert 'body.set("file", upload)' in server
+    assert 'body.set("source_asset_id", sourceAssetId)' in server
+    assert 'body.set("upload_path", SOURCE_ROW_UPLOAD_PATH)' in server
+    assert 'body.set("source_name"' in server
+    assert 'backendRequest("/ingest/configured-csv"' in server
+
+
+def test_path_identity_is_decoded_exactly_once() -> None:
+    library = _read("lib/source-row-upload.js")
+    assert library.count("decodeURIComponent") == 1
+    # The raw path segment wins over a framework-decoded param.
+    assert "segments[2] : params?.sourceAssetId" in library
+
+
+def test_sanitizers_are_allowlists_and_never_echo_diagnostics() -> None:
+    library = _read("lib/source-row-upload.js")
+    assert 'missing_required_column: "Required column is missing."' in library
+    assert "Required value missing for column '${column}'." in library
+    assert 'UNKNOWN_ISSUE = { code: "unknown", message: "Validation issue." }' in library
+    assert "skip_reason" not in library
+    assert "manifest_path" not in library and "raw_path" not in library
+
+
+def test_row_control_cannot_mutate_without_the_preflight_gate() -> None:
+    component = _read("components/source-row-upload.js")
+    assert component.startswith('"use client"')
+    assert 'aria-live="polite"' in component
+    assert 'type="button"' in component
+    assert "<form" not in component
+    page = _read("app/sources/page.js")
+    assert "<SourceRowUpload" in page
+    assert "resolveSourceUpload(ds, catalog)" in page
