  "work.evidence.tail-v1": {
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "type": "object"
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "item": {
          "anyOf": [
            {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "additionalProperties": false,
              "properties": {
                "chain_prev_digest": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "chain_seq": {
                  "minimum": 0,
                  "type": "integer"
                },
                "claims": {
                  "items": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "additionalProperties": false,
                    "properties": {
                      "claim_type": {
                        "enum": [
                          "target_stale",
                          "precondition_refused",
                          "capability_unavailable",
                          "evidence_persisted",
                          "effect_completed",
                          "effect_failed",
                          "effect_uncertain",
                          "effect_not_invoked",
                          "observation"
                        ]
                      },
                      "confirms": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "detail": {
                        "type": "object"
                      },
                      "freshness": {
                        "anyOf": [
                          {
                            "$schema": "https://json-schema.org/draft/2020-12/schema",
                            "additionalProperties": false,
                            "properties": {
                              "position": {
                                "type": "integer"
                              },
                              "scope": {
                                "minLength": 1,
                                "type": "string"
                              }
                            },
                            "required": [
                              "scope",
                              "position"
                            ],
                            "type": "object"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "grant_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "subject": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "claim_type",
                      "subject",
                      "grant_id",
                      "freshness",
                      "confirms",
                      "detail"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "collector": {
                  "minLength": 1,
                  "type": "string"
                },
                "digest": {
                  "minLength": 1,
                  "type": "string"
                },
                "item_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "kind": {
                  "minLength": 1,
                  "type": "string"
                },
                "provenance": {
                  "type": "object"
                },
                "ref": {
                  "minLength": 1,
                  "type": "string"
                },
                "validity": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "additionalProperties": false,
                  "properties": {
                    "basis": {
                      "enum": [
                        "indefinite",
                        "bounded",
                        "until_inputs_change"
                      ]
                    },
                    "component_digests": {
                      "type": "object"
                    },
                    "valid_from": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "valid_until": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "basis",
                    "valid_from",
                    "valid_until",
                    "component_digests"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "item_id",
                "kind",
                "ref",
                "digest",
                "collector",
                "validity",
                "claims",
                "provenance",
                "chain_seq",
                "chain_prev_digest"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "repo_id": {
          "type": "string"
        },
        "run_id": {
          "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        }
      },
      "required": [
        "repo_id",
        "run_id",
        "item"
      ],
      "type": "object"
    }
  },
